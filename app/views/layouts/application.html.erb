<%# Layout default de Rails. Hoy TODAS las pantallas usan `layout "auth"`;
    este queda como fallback de convención (una vista futura sin layout
    explícito cae aquí con CSS y csrf en lugar de renderizar pelona). %>
<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "Rueda de Negocios · FECEGO" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Rueda de Negocios · FECEGO">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-neutral-50 text-neutral-900 antialiased">
    <% if logged_in? %>
      <header class="bg-black text-white">
        <div class="container mx-auto flex items-center justify-between px-5 py-3">
          <%= link_to root_path, class: "flex items-center gap-3" do %>
            <%= image_tag "fecego_logo_white.png", alt: "FECEGO", class: "h-7 w-auto" %>
            <span class="text-sm font-semibold text-white/80">Rueda de Negocios</span>
          <% end %>
          <div class="flex items-center gap-4 text-sm">
            <span class="text-white/70"><%= current_user.full_name.presence || current_user.username %></span>
            <%# Con confirmación, como el estándar del shell (que usa modal):
                si una vista futura cae en este fallback, no debe caer con un
                cierre de sesión de un solo toque. El confirm nativo basta
                aquí — este layout no carga el controller del modal. %>
            <%= button_to "Cerrar sesión", logout_path, method: :delete,
                  form: { data: { turbo_confirm: "Se cerrará tu sesión. ¿Continuar?" } },
                  class: "rounded-md bg-white/10 px-3 py-1.5 font-medium hover:bg-white/20 transition-colors" %>
          </div>
        </div>
      </header>
    <% end %>

    <%= render "shared/flash" %>

    <main class="container mx-auto px-5 py-8">
      <%= yield %>
    </main>
  </body>
</html>
