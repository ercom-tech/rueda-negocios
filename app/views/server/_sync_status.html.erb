<%#
  Estado de la última corrida de un sync (down/up). Se renderiza sobre la card
  amarilla del menú del servidor y se reemplaza en vivo por Turbo Stream al
  terminar el job. Colores oscuros para contrastar con el amarillo.
  Locals: run (SyncRun o nil), kind (String — necesario cuando run es nil).
%>
<% kind ||= run&.kind %>
<div id="sync-<%= kind %>-status" class="mt-3 text-center text-sm">
  <% if run.nil? %>
    <span class="text-neutral-800/50">Sin corridas todavía.</span>

  <% elsif run.running? %>
    <span class="inline-flex items-center gap-2 font-medium text-neutral-800">
      <svg class="h-4 w-4 animate-spin text-neutral-700" viewBox="0 0 24 24" fill="none">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"/>
      </svg>
      En progreso…
    </span>

  <% elsif run.failed? %>
    <span class="font-semibold text-red-700">
      ✗ Falló<% if run.kind == "up" && run.summary["failed"].to_a.any? %>
        (<%= run.summary["failed"].size %> pedido(s) sin transmitir)<% end %>.
    </span>
    <% if run.message.present? %><span class="text-neutral-800/70"><%= run.message %></span><% end %>

  <% else # completed %>
    <span class="font-semibold text-emerald-800">✓ Listo</span>
    <span class="text-neutral-800/70">
      <% if run.kind == "down" %>
        <% e = run.summary["entities"] || {} %>
        · <%= number_with_delimiter(e["products"].to_i) %> productos
        · <%= e["clients"].to_i %> clientes
        · <%= e["users"].to_i %> usuarios
      <% else %>
        · <%= run.summary["transmitted"].to_a.size %> pedido(s) transmitido(s)
      <% end %>
      <% if run.finished_at %>· <%= run.finished_at.localtime.strftime("%d/%m %H:%M") %><% end %>
    </span>
  <% end %>
</div>
