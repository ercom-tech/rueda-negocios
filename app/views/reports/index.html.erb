<% content_for :title, "Reportes de venta · Rueda de Negocios" %>

<div class="relative flex min-h-screen w-full flex-col overflow-hidden bg-black">
  <%# Patrón de herramientas a pantalla completa (detrás de todo) %>
  <div class="pointer-events-none absolute inset-0 bg-cover bg-center opacity-[0.18]"
       style="background-image: url('<%= image_path "tools_pattern_white.svg" %>');"></div>

  <div class="relative z-10 flex min-h-screen flex-col px-6 py-6 sm:px-10 lg:px-[5%] lg:py-8">
    <%# ── Barra superior compartida (misma que el home) ── %>
    <%= render "shared/top_bar" %>

    <%# ── Cuerpo: tarjetas de reporte centradas, con el título arriba de las
        cards (izquierda) y el regreso al menú a la derecha ── %>
    <div class="flex flex-1 flex-col items-center justify-center py-10">
      <div class="w-full max-w-5xl">
      <div class="mb-8 flex flex-wrap items-center justify-between gap-4">
        <h1 class="text-3xl font-extrabold text-white sm:text-4xl">Reportes de venta</h1>
        <%= link_to "← Volver al menú", root_path,
              class: "rounded-full bg-white/10 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-white/20" %>
      </div>
      <div class="grid grid-cols-2 gap-6 sm:gap-8 lg:grid-cols-4">
        <%# Heroicons outline (mismo pack que los menús): clipboard-document-list ·
            clipboard-document-check (= Asistencia del menú) · cube · banknotes %>
        <% hero = {
             captured:   "M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25ZM6.75 12h.008v.008H6.75V12Zm0 3h.008v.008H6.75V15Zm0 3h.008v.008H6.75V18Z",
             attendance: "M11.35 3.836c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m8.9-4.414c.376.023.75.05 1.124.08 1.131.094 1.976 1.057 1.976 2.192V16.5A2.25 2.25 0 0 1 18 18.75h-2.25m-7.5-10.5H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V18.75m-7.5-10.5h6.375c.621 0 1.125.504 1.125 1.125v9.375m-8.25-3 1.5 1.5 3-3.75",
             products:   "m21 7.5-9-5.25L3 7.5m18 0-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9",
             sales:      "M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm3 0h.008v.008H18V10.5Zm-12 0h.008v.008H6V10.5Z"
           } %>
        <%= render "report_card", href: captured_orders_report_path, icon_path: hero[:captured],
              label: ["Pedidos", "capturados"] %>
        <%= render "report_card", href: "#", icon_path: hero[:attendance], soon: true,
              label: ["Reporte de", "asistencia"] %>
        <%= render "report_card", href: "#", icon_path: hero[:products], soon: true,
              label: ["Reporte de", "productos"] %>
        <%= render "report_card", href: "#", icon_path: hero[:sales], soon: true,
              label: ["Reporte de", "ventas"] %>
      </div>
      </div>
    </div>
  </div>
</div>
