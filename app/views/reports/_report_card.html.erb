<%#
  Tarjeta cuadrada del hub de reportes.
  Locals: href, icon, label (String o Array de líneas), soon (bool — "Próximamente").
%>
<% soon = local_assigns[:soon] %>
<% base = "relative flex aspect-square flex-col items-center justify-center gap-5 rounded-3xl bg-[#EDC94C] p-6 text-center shadow-lg" %>

<% inner = capture do %>
  <%= image_tag icon, alt: "", class: "h-20 w-20 brightness-0" %>
  <span class="text-xl font-bold leading-tight text-neutral-900"><%= safe_join(Array(label), tag.br) %></span>
  <% if soon %>
    <span class="absolute inset-x-4 bottom-3 rounded-full bg-black/20 px-3 py-1 text-xs font-semibold text-neutral-900">Próximamente</span>
  <% end %>
<% end %>

<% if soon %>
  <div class="<%= base %> cursor-not-allowed opacity-60" aria-disabled="true" title="Próximamente"><%= inner %></div>
<% else %>
  <%= link_to href, class: "#{base} transition-transform hover:scale-[1.03]" do %><%= inner %><% end %>
<% end %>
