<%#
  Tarjeta cuadrada del hub de reportes.
  Locals: href, icon, label (String o Array de líneas), soon (bool — "Próximamente").
%>
<% soon = local_assigns[:soon] %>
<%# En "Próximamente" el fondo se atenúa con alpha (bg .../60), que —a diferencia
    de opacity— NO afecta a los hijos, así el badge queda a plena opacidad. %>
<% card_bg = soon ? "bg-brand-gold/60" : "bg-brand-gold" %>
<% base = "relative flex aspect-square flex-col items-center justify-center rounded-3xl #{card_bg} p-6 text-center shadow-lg" %>

<% inner = capture do %>
  <%# El contenido se atenúa cuando es "Próximamente"; el badge NO (queda a
      plena opacidad, en amarillo sólido, para resaltar sobre la card apagada). %>
  <div class="flex flex-col items-center gap-5 <%= "opacity-60" if soon %>">
    <%= image_tag icon, alt: "", class: "h-20 w-20 brightness-0" %>
    <span class="text-xl font-bold leading-tight text-neutral-900"><%= safe_join(Array(label), tag.br) %></span>
  </div>
  <% if soon %>
    <span class="absolute inset-x-4 bottom-3 rounded-full bg-brand-gold px-3 py-1 text-xs font-semibold text-neutral-900 shadow-md ring-1 ring-black/10">Próximamente</span>
  <% end %>
<% end %>

<% if soon %>
  <div class="<%= base %> cursor-not-allowed" aria-disabled="true" title="Próximamente"><%= inner %></div>
<% else %>
  <%= link_to href, class: "#{base} transition-transform hover:scale-[1.03]" do %><%= inner %><% end %>
<% end %>
