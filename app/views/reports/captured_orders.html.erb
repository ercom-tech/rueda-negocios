<% content_for :title, "Pedidos capturados · Rueda de Negocios" %>

<div class="relative min-h-screen w-full overflow-hidden bg-black text-white">
  <div class="pointer-events-none absolute inset-0 bg-cover bg-center opacity-[0.18]"
       style="background-image: url('<%= image_path "tools_pattern_white.svg" %>');"></div>

  <div class="relative z-10 flex min-h-screen flex-col px-6 py-6 sm:px-10 lg:px-[5%] lg:py-8">
    <%# ── Barra superior compartida (misma que el home) ── %>
    <%= render "shared/top_bar" %>

    <%# ── Título + alcance + regreso al hub ── %>
    <div class="mt-8 mb-6 flex flex-wrap items-center justify-between gap-4">
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="text-3xl font-extrabold text-white sm:text-4xl">Pedidos capturados</h1>
        <span class="rounded-full bg-brand-gold px-3 py-1 text-xs font-semibold text-neutral-900">
          <%= @all_scope ? "Todos los pedidos" : "Mis pedidos" %>
        </span>
      </div>
      <%= link_to "← Volver a reportes", reports_path,
            class: "rounded-full bg-white/10 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-white/20" %>
    </div>

    <div class="w-full">
    <%# Orden de lectura: filtros → agregado → detalle → navegación. %>
    <%= render "filters", filter: @filter, options: @options, per_page: @pagy.limit %>
    <%= render "status_summary", summary: @summary, filter: @filter, per_page: @pagy.limit,
          supplier_name: (@options[:suppliers].find { |(_n, id)| id == @filter.supplier_id }&.first),
          brand_name: (@options[:brands].find { |(_n, id)| id == @filter.brand_id }&.first) %>

    <div class="overflow-x-auto rounded-3xl border border-white/10 bg-brand-cream text-neutral-900">
      <table class="w-full text-sm">
        <thead class="bg-black text-white">
          <tr>
            <% if @all_scope %>
              <th class="px-4 py-3 text-left font-semibold">Capturista</th>
            <% end %>
            <th class="px-4 py-3 text-left font-semibold">Fecha</th>
            <th class="hidden px-4 py-3 text-left font-semibold lg:table-cell">Hora</th>
            <th class="px-4 py-3 text-left font-semibold">Cliente</th>
            <th class="hidden px-4 py-3 text-left font-semibold lg:table-cell">Vendedor</th>
            <th class="px-4 py-3 text-left font-semibold">Clave local</th>
            <th class="px-4 py-3 text-right font-semibold">Renglones</th>
            <th class="px-4 py-3 text-right font-semibold">Total</th>
            <th class="px-4 py-3 text-center font-semibold">Estatus</th>
          </tr>
        </thead>
        <tbody>
          <% @orders.each do |order| %>
            <% captured = order.created_at.localtime %>
            <tr class="border-t border-black/10">
              <% if @all_scope %>
                <td class="px-4 py-3"><%= order.user.full_name.presence || order.user.username %></td>
              <% end %>
              <td class="px-4 py-3 whitespace-nowrap"><%= captured.strftime("%d/%m/%Y") %></td>
              <td class="hidden px-4 py-3 lg:table-cell"><%= captured.strftime("%H:%M") %></td>
              <td class="px-4 py-3">
                <span class="font-semibold"><%= order.client.erp_client_key %></span>
                — <%= order.client.name %>
              </td>
              <td class="hidden px-4 py-3 lg:table-cell">
                <% if (sp = order.client.salesperson) %>
                  <span class="font-semibold"><%= sp.erp_salesperson_id %></span> — <%= sp.name %>
                <% else %>
                  —
                <% end %>
              </td>
              <td class="px-4 py-3 font-semibold whitespace-nowrap">
                <%= link_to order.folio, order_path(order), title: "Abrir pedido",
                      class: "underline decoration-brand-gold decoration-2 underline-offset-4 hover:text-brand-coral" %>
              </td>
              <%# Con filtro de partida, renglones e importe son los de las
                  partidas que coinciden (el aviso arriba del resumen lo dice). %>
              <% coincide = @matching&.dig(order.id) %>
              <td class="px-4 py-3 text-right"><%= coincide ? coincide[:count] : order.order_items.size %></td>
              <td class="px-4 py-3 text-right whitespace-nowrap"><%= number_to_currency(coincide ? coincide[:total] : order.total) %></td>
              <td class="px-4 py-3 text-center">
                <span class="rounded-full px-3 py-1 text-xs font-semibold <%= order.status_color %>">
                  <%= order.status_label %>
                </span>
              </td>
            </tr>
          <% end %>
          <%# Con siete filtros que aplican al seleccionar es fácil quedar en
              cero: "No hay pedidos capturados" se leería como que se perdieron
              los pedidos y dispararía una llamada al equipo del servidor. %>
          <% if @orders.empty? %>
            <tr>
              <td colspan="<%= @all_scope ? 9 : 8 %>" class="px-4 py-10 text-center text-neutral-500">
                <% if @filter.any? %>
                  Ningún pedido coincide con lo que elegiste.
                  <%= link_to "Quitar filtros", captured_orders_report_path(per_page: @pagy.limit),
                        class: "ml-2 font-semibold text-neutral-900 underline decoration-brand-gold decoration-2 underline-offset-4" %>
                <% else %>
                  Todavía no hay pedidos capturados.
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= render "shared/paginator", pagy: @pagy, noun: "pedido",
          base_params: @filter.to_params, page_sizes: @page_sizes %>
    </div>
  </div>
</div>
