<% content_for :title, "Pedidos capturados · Rueda de Negocios" %>

<div class="relative min-h-screen w-full overflow-hidden bg-black text-white">
  <div class="pointer-events-none absolute inset-0 bg-cover bg-center opacity-[0.18]"
       style="background-image: url('<%= image_path "tools_pattern_white.svg" %>');"></div>

  <div class="relative z-10 flex min-h-screen flex-col px-6 py-6 sm:px-10 lg:px-[5%] lg:py-8">
    <%# ── Barra superior compartida (misma que el home) ── %>
    <%= render "shared/top_bar" %>

    <%# ── Título + alcance + regreso al hub ── %>
    <div class="mt-8 mb-6 flex flex-wrap items-center justify-between gap-4">
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="text-3xl font-extrabold text-white sm:text-4xl">Pedidos capturados</h1>
        <span class="rounded-full bg-brand-gold px-3 py-1 text-xs font-semibold text-neutral-900">
          <%= @all_scope ? "Todos los pedidos" : "Mis pedidos" %>
        </span>
      </div>
      <%= link_to "← Volver a reportes", reports_path, class: back_link_class %>
    </div>

    <div class="w-full">
    <%# Orden de lectura: filtros → agregado → detalle → navegación. %>
    <%= render "filters", filter: @filter, options: @options, per_page: @pagy.limit %>
    <%= render "status_summary", summary: @summary, filter: @filter, per_page: @pagy.limit %>

    <div class="overflow-x-auto rounded-3xl border border-black/10 bg-brand-cream text-neutral-900">
      <table class="w-full text-sm">
        <%# Encabezados ordenables. `sort_params` lleva los filtros y el tamaño
            de página para que el orden no los pierda; `page` se descarta en el
            helper, porque reordenar y quedarse en la página 7 deja al usuario
            en medio de una lista que ya no es la que veía.
            "Hora" ordena por la misma columna que "Fecha" (`created_at`): son
            la misma marca de tiempo partida en dos celdas. %>
        <% sort_params = @filter.to_params.merge(per_page: @pagy.limit) %>
        <thead class="bg-black text-white">
          <tr>
            <% if @all_scope %>
              <%= sortable_header "user", "Capturista", sort: @sort, base_params: sort_params %>
            <% end %>
            <%= sortable_header "date", "Fecha", sort: @sort, base_params: sort_params %>
            <th class="hidden px-4 py-3 text-left font-semibold lg:table-cell"
                aria-sort="<%= @sort.active?("time") ? (@sort.dir == "asc" ? "ascending" : "descending") : "none" %>">
              <%= link_to url_for(sort_params.merge(sort: "time", dir: @sort.next_dir_for("time"), page: nil)),
                    class: sort_header_class(@sort.active?("time")) do %>
                Hora<%= sort_caret @sort.direction_for("time") %>
              <% end %>
            </th>
            <%= sortable_header "client", "Cliente", sort: @sort, base_params: sort_params %>
            <th class="hidden px-4 py-3 text-left font-semibold lg:table-cell"
                aria-sort="<%= @sort.active?("salesperson") ? (@sort.dir == "asc" ? "ascending" : "descending") : "none" %>">
              <%= link_to url_for(sort_params.merge(sort: "salesperson", dir: @sort.next_dir_for("salesperson"), page: nil)),
                    class: sort_header_class(@sort.active?("salesperson")) do %>
                Vendedor<%= sort_caret @sort.direction_for("salesperson") %>
              <% end %>
            </th>
            <%= sortable_header "folio", "Clave local", sort: @sort, base_params: sort_params %>
            <%= sortable_header "items", "Renglones", sort: @sort, base_params: sort_params, align: "right" %>
            <%= sortable_header "total", "Total", sort: @sort, base_params: sort_params, align: "right" %>
            <%= sortable_header "status", "Estatus", sort: @sort, base_params: sort_params, align: "center" %>
          </tr>
        </thead>
        <tbody>
          <% @orders.each do |order| %>
            <% captured = order.created_at.localtime %>
            <tr class="border-t border-black/10">
              <% if @all_scope %>
                <td class="px-4 py-3"><%= order.user.full_name.presence || order.user.username %></td>
              <% end %>
              <td class="px-4 py-3 whitespace-nowrap"><%= captured.strftime("%d/%m/%Y") %></td>
              <td class="hidden px-4 py-3 lg:table-cell"><%= captured.strftime("%H:%M") %></td>
              <td class="px-4 py-3">
                <span class="font-semibold"><%= order.client.erp_client_key %></span>
                — <%= order.client.name %>
              </td>
              <td class="hidden px-4 py-3 lg:table-cell">
                <% if (sp = order.client.salesperson) %>
                  <span class="font-semibold"><%= sp.erp_salesperson_id %></span> — <%= sp.name %>
                <% else %>
                  —
                <% end %>
              </td>
              <td class="px-4 py-3 font-semibold whitespace-nowrap">
                <%= link_to order.folio, order_path(order), title: "Abrir pedido",
                      class: "underline decoration-brand-coral-dark decoration-2 underline-offset-4 hover:text-brand-coral" %>
              </td>
              <%# Con filtro de partida, renglones e importe son los de las
                  partidas que coinciden (el aviso arriba del resumen lo dice). %>
              <% matching = @matching&.dig(order.id) %>
              <td class="px-4 py-3 text-right"><%= matching ? matching[:count] : order.order_items.size %></td>
              <td class="px-4 py-3 text-right whitespace-nowrap"><%= number_to_currency(matching ? matching[:total] : order.total) %></td>
              <td class="px-4 py-3 text-center">
                <span class="rounded-full px-3 py-1 text-xs font-semibold <%= order.status_color %>">
                  <%= order.status_label %>
                </span>
              </td>
            </tr>
          <% end %>
          <%# Con siete filtros que aplican al seleccionar es fácil quedar en
              cero: "No hay pedidos capturados" se leería como que se perdieron
              los pedidos y dispararía una llamada al equipo del servidor. %>
          <% if @orders.empty? %>
            <tr>
              <td colspan="<%= @all_scope ? 9 : 8 %>" class="px-4 py-10 text-center text-neutral-600">
                <% if @filter.any? %>
                  Ningún pedido coincide con lo que elegiste.
                  <%= link_to "Quitar filtros", captured_orders_report_path(per_page: @pagy.limit),
                        class: "ml-2 font-semibold text-neutral-900 underline decoration-brand-coral-dark decoration-2 underline-offset-4" %>
                <% else %>
                  Todavía no hay pedidos capturados.
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%# El orden viaja con los filtros: cambiar de página no puede reordenar
        la tabla por debajo. %>
    <%# Hora y Vendedor se ocultan en tablet, y con ellas su flecha y su
        encabezado dorado: ordenando por una de las dos, la tabla quedaba
        ordenada por un criterio invisible. Aquí se dice, y solo cuando hace
        falta (`lg:hidden`, el mismo corte que esconde las columnas). %>
    <% if @sort.hidden_on_tablet? %>
      <p class="mt-4 text-sm text-white/70 lg:hidden">
        Ordenado por <span class="font-semibold text-brand-gold"><%= @sort.label %></span>,
        <%= @sort.dir == "asc" ? "de menor a mayor" : "de mayor a menor" %>.
        <span class="block">Esa columna no se muestra a este ancho.</span>
      </p>
    <% end %>

    <%= render "shared/paginator", pagy: @pagy, noun: "pedido",
          base_params: @filter.to_params.merge(@sort.to_params).merge(per_page: @pagy.limit),
          page_sizes: @page_sizes %>
    </div>
  </div>
</div>
