<% content_for :title, "Menú · Rueda de Negocios" %>

<div class="relative min-h-screen w-full overflow-hidden bg-black">
  <%# Patrón de herramientas a todo lo ancho (mismo asset que el login) %>
  <div class="pointer-events-none absolute inset-0 bg-cover bg-center opacity-[0.18]"
       style="background-image: url('<%= image_path "tools_pattern_white.svg" %>');"></div>

  <div class="relative z-10 flex min-h-screen flex-col px-6 py-6 sm:px-10 lg:px-[7%] lg:py-8">
    <%# Stream de estado del sync (solo server). Fuera del grid: es invisible y
        no debe contar como celda del layout. %>
    <% if current_user.can_see_all_orders? %><%= turbo_stream_from "sync_status" %><% end %>

    <%# ── Barra superior: logo + pills de contexto + cerrar sesión ── %>
    <header class="flex flex-wrap items-center justify-between gap-4">
      <%= image_tag "fecego_logo_white.png", alt: "FECEGO", class: "h-14 w-auto" %>

      <div class="flex flex-wrap items-center gap-3 text-sm">
        <span class="rounded-full bg-brand-cream px-5 py-2.5 text-neutral-800">
          Usuario: <span class="font-semibold"><%= current_user.full_name.presence || current_user.username %></span>
        </span>
        <%# El pill de proveedor no aplica al servidor (no captura pedidos). %>
        <% unless current_user.can_see_all_orders? %>
          <%= render "shared/supplier_pill" %>
        <% end %>

        <%# Cerrar sesión es reversible (no pierde captura) → acción directa sin
            modal. El modal de confirmación se reserva para lo destructivo/pesado
            (descartar pedido, quitar producto, sync). Mismo patrón para todos. %>
        <%= button_to "Cerrar sesión", logout_path, method: :delete,
              class: "rounded-full bg-neutral-400 px-5 py-2.5 font-semibold text-neutral-900 transition-colors hover:bg-neutral-300" %>
      </div>
    </header>

    <%# ── Contenido: izq (título + ilustración) · der (tarjetas) ── %>
    <div class="grid flex-1 items-center gap-10 py-10 lg:grid-cols-2 lg:gap-14">
      <div>
        <h1 class="text-5xl font-extrabold leading-[1.03] text-white sm:text-6xl">
          ¿Qué quieres<br>hacer hoy?
        </h1>
        <%= image_tag "expo_illustration.svg", alt: "Expo · Rueda de Negocios",
              class: "mt-12 w-full max-w-lg" %>
      </div>

      <% if current_user.can_see_all_orders? %>
        <%= render "home/server_menu", setting: @setting, sync_down: @sync_down, sync_up: @sync_up %>
      <% else %>
        <div class="flex flex-col gap-5">
          <%# Heroicons outline (mismo pack que el menú del servidor):
              shopping-cart · chart-bar · clipboard-document-check · calculator %>
          <% hero = {
               cart:       "M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z",
               chart:      "M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z",
               clipboard:  "M11.35 3.836c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m8.9-4.414c.376.023.75.05 1.124.08 1.131.094 1.976 1.057 1.976 2.192V16.5A2.25 2.25 0 0 1 18 18.75h-2.25m-7.5-10.5H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V18.75m-7.5-10.5h6.375c.621 0 1.125.504 1.125 1.125v9.375m-8.25-3 1.5 1.5 3-3.75",
               calculator: "M15.75 15.75V18m-7.5-6.75h.008v.008H8.25v-.008Zm0 2.25h.008v.008H8.25V13.5Zm0 2.25h.008v.008H8.25v-.008Zm0 2.25h.008v.008H8.25V18Zm2.498-6.75h.007v.008h-.007v-.008Zm0 2.25h.007v.008h-.007V13.5Zm0 2.25h.007v.008h-.007v-.008Zm0 2.25h.007v.008h-.007V18Zm2.504-6.75h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V13.5Zm0 2.25h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V18Zm2.498-6.75h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V13.5ZM8.25 6h7.5v2.25h-7.5V6ZM12 2.25c-1.892 0-3.758.11-5.593.322C5.307 2.7 4.5 3.65 4.5 4.757V19.5a2.25 2.25 0 0 0 2.25 2.25h10.5a2.25 2.25 0 0 0 2.25-2.25V4.757c0-1.108-.806-2.057-1.907-2.185A48.507 48.507 0 0 0 12 2.25Z"
             } %>
          <%= render "menu_card", href: new_order_path, accent: :coral, icon_path: hero[:cart],
                title: ["Registrar", "pedido"], desc: "Envía pedidos confirmados directamente a surtido." %>
          <%= render "menu_card", href: reports_path, accent: :yellow, icon_path: hero[:chart],
                title: ["Reportes", "de venta"], desc: "Visualiza tus métricas y resultados del evento." %>
          <%= render "menu_card", href: "#", accent: :yellow, icon_path: hero[:clipboard], soon: true,
                title: ["Asistencia", "de clientes"], desc: "Monitorea qué clientes ya fueron atendidos y cuáles siguen pendientes." %>
          <%= render "menu_card", href: "#", accent: :yellow, icon_path: hero[:calculator], soon: true,
                title: ["Generar", "cotización"], desc: "Simula el pedido de tu cliente antes de confirmar la compra." %>
        </div>
      <% end %>
    </div>
  </div>
</div>
