<%#
  Diálogo de confirmación. Va DENTRO de un contenedor con
  data-controller="modal"; el botón que lo abre usa data-action="modal#open".
  Locals: title, message, confirm_label, path, method (default :post),
  params (Hash opcional — viaja en el form del botón de confirmación).
%>
<% dialog_id = "dlg-#{SecureRandom.hex(4)}" %>
<div data-modal-target="dialog" style="display:none"
     role="dialog" aria-modal="true"
     aria-labelledby="<%= dialog_id %>-title" aria-describedby="<%= dialog_id %>-msg"
     class="fixed inset-0 z-50 items-center justify-center p-4">
  <div class="absolute inset-0 bg-black/50" data-action="click->modal#close"></div>
  <div class="relative w-full max-w-md rounded-3xl bg-brand-gold p-6 shadow-2xl sm:p-8">
    <div class="rounded-2xl bg-black py-4 text-center">
      <h3 id="<%= dialog_id %>-title" class="text-xl font-extrabold text-white"><%= title %></h3>
    </div>
    <p id="<%= dialog_id %>-msg" class="mt-6 text-center text-lg text-neutral-900"><%= message %></p>
    <div class="mt-8 flex justify-center gap-3">
      <button type="button" data-action="modal#close"
              class="rounded-full bg-neutral-700 px-6 py-2.5 font-bold text-white transition-colors hover:bg-neutral-600">
        Cancelar
      </button>
      <%= button_to confirm_label, path, method: (local_assigns[:method] || :post),
            params: (local_assigns[:params] || {}),
            class: "rounded-full bg-brand-coral px-6 py-2.5 font-bold text-white transition-colors hover:bg-brand-coral-dark" %>
    </div>
  </div>
</div>
