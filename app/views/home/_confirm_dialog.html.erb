<%#
  Diálogo de confirmación. Va DENTRO de un contenedor con
  data-controller="modal"; el botón que lo abre usa data-action="modal#open".
  Locals: title, message, confirm_label, path, method (default :post),
  params (Hash opcional — viaja en el form del botón de confirmación);
  form (opcional: id de un formulario de la página — el botón lo envía en
  vez de armar su propio form; así confirma el paso 1 de una conversión
  sin duplicar sus campos, y `path`/`method` no se usan).
%>
<%# `id`: obligatorio cuando el diálogo vive dentro de una región que se
    repinta con morph. Con `permanent: true` se marca `data-turbo-permanent`,
    y entonces el id tiene que ser ESTABLE entre repintados (dom_id del
    registro, no un aleatorio) o Turbo no sabrá qué conservar. %>
<% dialog_id = local_assigns[:id].presence || "dlg-#{SecureRandom.hex(4)}" %>
<div id="<%= dialog_id %>" data-modal-target="dialog" style="display:none"
     <%= "data-turbo-permanent".html_safe if local_assigns[:permanent] %>
     role="dialog" aria-modal="true"
     aria-labelledby="<%= dialog_id %>-title" aria-describedby="<%= dialog_id %>-msg"
     class="fixed inset-0 z-50 items-center justify-center p-4">
  <div class="absolute inset-0 bg-black/50" data-action="click->modal#close"></div>
  <div class="relative w-full max-w-md rounded-3xl bg-brand-gold p-6 shadow-2xl sm:p-8">
    <div class="rounded-2xl bg-black py-4 text-center">
      <h3 id="<%= dialog_id %>-title" class="text-xl font-extrabold text-white"><%= title %></h3>
    </div>
    <p id="<%= dialog_id %>-msg" class="mt-6 text-center text-lg text-neutral-900"><%= message %></p>
    <div class="mt-8 flex justify-center gap-3">
      <button type="button" data-action="modal#close"
              class="rounded-full bg-neutral-700 px-6 py-2.5 font-bold text-white transition-colors hover:bg-neutral-600">
        Cancelar
      </button>
      <% confirm_class = "rounded-full bg-brand-coral px-6 py-2.5 font-bold text-white transition-colors hover:bg-brand-coral-dark" %>
      <% if local_assigns[:form] %>
        <button type="submit" form="<%= form %>" class="cursor-pointer <%= confirm_class %>"><%= confirm_label %></button>
      <% else %>
        <%# Se cierra al terminar el envío (convenciones: "un modal que actúa
            debe cerrarse al terminar"). Con éxito no se nota —la página
            navega—, pero cuando la acción no procede (un sync vivo responde
            422 con el aviso en el flash) el modal se quedaba abierto encima
            del aviso (18ª auditoría). %>
        <%= button_to confirm_label, path, method: (local_assigns[:method] || :post),
              params: (local_assigns[:params] || {}),
              form: { data: { action: "turbo:submit-end->modal#close" } },
              class: confirm_class %>
      <% end %>
    </div>
  </div>
</div>
