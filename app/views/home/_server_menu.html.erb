<%#
  Menú del rol server: operación del sync (columna derecha del grid, un solo
  div — igual que el menú del capturista). Cada card usa el MISMO grid de 3
  columnas fijas (icono · título · descripción) para alinear las 4 cards pese a
  mezclar link y botón. El título va CENTRADO en su columna (mismo aire a ambos
  lados, `text-right` interno para el corte a 2 líneas) y la descripción a la
  izquierda — igual que `menu_card`. Íconos Heroicons (outline). El
  turbo_stream_from vive en el index, fuera del grid.
  Locals: setting, sync_down, sync_up.
%>
<% has_round = setting.selected_round_erp_id.present? %>
<%# Con una corrida viva (down O up) se bloquean Obtener/Transmitir/Cerrar —
    espejo de los guards del controller. El broadcast de SyncRun reemplaza
    este div completo (id server-menu) al cerrar el run, así los botones se
    rehabilitan en vivo. %>
<% sync_busy = sync_down&.running? || sync_up&.running? %>
<% locked = !has_round || sync_busy %>
<% grid  = "grid grid-cols-[3.5rem_11rem_minmax(0,1fr)] items-center gap-6" %>
<% title = "justify-self-center text-right text-2xl font-extrabold leading-tight" %>
<% desc  = "text-left text-xl leading-snug" %>

<div id="server-menu" class="flex flex-col gap-5">
  <%# ── 1. Elegir rueda (coral) — Heroicon calendar-days. Con rueda en
       curso queda deshabilitada (el cambio de rueda pasa por "Cerrar
       rueda"); el controller protege además rounds/select_round. ────── %>
  <% round_icon = capture do %>
    <svg class="h-14 w-14 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
    </svg>
  <% end %>
  <% if has_round %>
    <%# El 60% va solo al ÍCONO y al título, no al párrafo: este es el único
        lugar de toda la app donde aparece el nombre de la rueda cargada, y
        atenuado quedaba en ~2.9:1 con el patrón del fondo asomándose. El
        operador que llega entre un día y otro necesita leerlo antes de picar
        "Obtener información". Misma receta que el contador de partidas. %>
    <div class="<%= grid %> rounded-[1.75rem] bg-brand-coral px-7 py-5 shadow-lg" aria-disabled="true">
      <div class="opacity-60"><%= round_icon %></div>
      <h3 class="<%= title %> whitespace-nowrap text-white opacity-60">Elegir rueda</h3>
      <p class="<%= desc %> text-white">
        En curso: <span class="font-semibold"><%= setting.selected_round_name.presence || "Rueda ##{setting.selected_round_erp_id}" %></span>.
        Ciérrala para elegir otra.
      </p>
    </div>
  <% else %>
    <%= link_to server_rounds_path,
          class: "#{grid} rounded-[1.75rem] bg-brand-coral px-7 py-5 shadow-lg transition-transform hover:scale-[1.015]" do %>
      <%= round_icon %>
      <h3 class="<%= title %> whitespace-nowrap text-white">Elegir rueda</h3>
      <p class="<%= desc %> text-white/90">Ninguna seleccionada todavía.</p>
    <% end %>
  <% end %>

  <%# ── 2. Obtener información / sync-down (amarilla) — arrow-down-tray.
       El hover escala la CARD VISIBLE completa (botón + estado), como en las
       cards-link; el diálogo del modal queda FUERA del nodo que se
       transforma (un transform en el ancestro rompe su position: fixed). ── %>
  <div data-controller="modal" data-action="keydown@window->modal#closeOnEsc">
    <div class="rounded-[1.75rem] bg-brand-gold px-7 py-5 shadow-lg <%= locked ? "opacity-60" : "transition-transform hover:scale-[1.015]" %>">
      <button type="button" data-action="modal#open" <%= "disabled" if locked %>
              class="<%= grid %> w-full">
        <svg class="h-14 w-14 text-neutral-900" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
        </svg>
        <h3 class="<%= title %> text-neutral-900"><%= safe_join(["Obtener", "información"], tag.br) %></h3>
        <p class="<%= desc %> text-neutral-800/75">Descarga los datos de la rueda desde el servidor.</p>
      </button>
      <%= render "server/sync_status", kind: "down", run: sync_down %>
    </div>
    <%# Las guardas ya bloquean con borradores o con capturados sin transmitir,
        así que lo único que puede haber en la laptop al llegar aquí son
        pedidos ya transmitidos — y el reemplazo los quita. Decirlo con el
        número: antes solo se hablaba de "reemplazar la información local" y el
        reporte del día anterior amanecía en cero sin explicación. %>
    <% transmitted = Order.transmitted.count %>
    <% down_message = [
         "Se descargarán los datos de la rueda seleccionada y se reemplazará la información local.",
         ("Se #{transmitted == 1 ? 'quitará' : 'quitarán'} #{transmitted} " \
          "#{transmitted == 1 ? 'pedido' : 'pedidos'} ya " \
          "#{transmitted == 1 ? 'transmitido' : 'transmitidos'}." if transmitted.positive?),
         "¿Continuar?"
       ].compact.join(" ") %>
    <%= render "home/confirm_dialog", title: "Obtener información",
          message: down_message, confirm_label: "Sí, obtener", path: server_sync_down_path %>
  </div>

  <%# ── 3. Transmitir pedidos / sync-up (amarilla) — arrow-up-tray ── %>
  <div data-controller="modal" data-action="keydown@window->modal#closeOnEsc">
    <div class="rounded-[1.75rem] bg-brand-gold px-7 py-5 shadow-lg <%= locked ? "opacity-60" : "transition-transform hover:scale-[1.015]" %>">
      <button type="button" data-action="modal#open" <%= "disabled" if locked %>
              class="<%= grid %> w-full">
        <svg class="h-14 w-14 text-neutral-900" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" />
        </svg>
        <h3 class="<%= title %> text-neutral-900"><%= safe_join(["Transmitir", "pedidos"], tag.br) %></h3>
        <p class="<%= desc %> text-neutral-800/75">Envía los pedidos capturados al ERP.</p>
      </button>
      <%= render "server/sync_status", kind: "up", run: sync_up %>
    </div>
    <%= render "home/confirm_dialog", title: "Transmitir pedidos",
          message: "Se enviarán al ERP los pedidos capturados que aún no se han transmitido. ¿Continuar?",
          confirm_label: "Sí, transmitir", path: server_sync_up_path %>
  </div>

  <%# ── 4. Reportes (amarilla) — chart-bar. Sin rueda no hay nada que
       reportar (guard también en ReportsController). ───────────────── %>
  <% reports_icon = capture do %>
    <svg class="h-14 w-14 text-neutral-900" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" />
    </svg>
  <% end %>
  <% reports_body = capture do %>
    <%= reports_icon %>
    <h3 class="<%= title %> text-neutral-900"><%= safe_join(["Reportes", "de venta"], tag.br) %></h3>
    <p class="<%= desc %> text-neutral-800/75">Consulta todos los pedidos capturados en el evento.</p>
  <% end %>
  <% if has_round %>
    <%= link_to reports_path,
          class: "#{grid} rounded-[1.75rem] bg-brand-gold px-7 py-5 shadow-lg transition-transform hover:scale-[1.015]" do %>
      <%= reports_body %>
    <% end %>
  <% else %>
    <div class="<%= grid %> rounded-[1.75rem] bg-brand-gold px-7 py-5 opacity-60 shadow-lg" aria-disabled="true">
      <%= reports_body %>
    </div>
  <% end %>

  <%# ── 5. Cerrar rueda (neutra oscura, destructiva → modal) — archive-box ── %>
  <div data-controller="modal" data-action="keydown@window->modal#closeOnEsc">
    <div class="rounded-[1.75rem] bg-neutral-700 px-7 py-5 shadow-lg <%= locked ? "opacity-60" : "transition-transform hover:scale-[1.015]" %>">
      <button type="button" data-action="modal#open" <%= "disabled" if locked %>
              class="<%= grid %> w-full">
        <svg class="h-14 w-14 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m20.25 7.5-.625 10.632a2.25 2.25 0 0 1-2.247 2.118H6.622a2.25 2.25 0 0 1-2.247-2.118L3.75 7.5m8.25 3v6.75m0 0-3-3m3 3 3-3M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z" />
        </svg>
        <h3 class="<%= title %> whitespace-nowrap text-white">Cerrar rueda</h3>
        <p class="<%= desc %> text-white/80">Elimina los pedidos locales para poder cargar otra rueda.</p>
      </button>
    </div>
    <%= render "home/confirm_dialog", title: "Cerrar rueda",
          message: "Se eliminarán TODOS los pedidos locales (los transmitidos ya están en el ERP) y se limpiará la rueda seleccionada. Solo procede si ya transmitiste todo. ¿Continuar?",
          confirm_label: "Sí, cerrar rueda", path: server_close_round_path %>
  </div>
</div>
