<%# Contenedor siempre presente (id "flash") para poder reemplazarlo por Turbo
    Stream. Locals opcionales notice/alert (por defecto, los del flash). %>
<% notice = local_assigns.fetch(:notice, flash[:notice]) %>
<% alert  = local_assigns.fetch(:alert,  flash[:alert]) %>
<div id="flash" class="pointer-events-none fixed inset-x-0 top-4 z-50 flex flex-col items-center gap-2 px-4">
  <% if notice.present? %>
    <div role="status" data-controller="flash"
         class="pointer-events-auto flex items-center gap-3 rounded-lg bg-emerald-600 px-4 py-2 text-sm text-white shadow-lg">
      <span><%= notice %></span>
      <%# Heroicon outline `x-mark`: el &times; tipográfico era el único cierre
          del sitio que no era un ícono del pack. %>
      <%# Área táctil de 44px (como el bote de basura de las partidas): el
          único cuerpo del botón era el ícono de 16px, imposible de atinar en
          tablet — y los alerts no se cierran solos, así que este botón es el
          único camino. Los márgenes negativos conservan el tamaño del pill. %>
      <button type="button" data-action="flash#dismiss" aria-label="Cerrar aviso"
              class="-my-2.5 -mr-3 flex h-11 w-11 shrink-0 items-center justify-center text-white/80 transition-colors hover:text-white">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  <% end %>
  <%# Los avisos NO se auto-cierran (delay 0): por aquí viajan las
      instrucciones de dos pasos de las guardas del sync —unas 30 palabras, más
      de lo que se lee en los 8 segundos que duraban—, y aparecen arriba al
      centro mientras el operador mira la card que acaba de picar. Se cerraban
      antes de que alcanzara a leerlos y no había forma de recuperarlos. Los
      `notice` sí siguen desapareciendo solos: son confirmaciones. %>
  <% if alert.present? %>
    <div role="alert" data-controller="flash" data-flash-delay-value="0"
         class="pointer-events-auto flex items-center gap-3 rounded-lg bg-red-700 px-4 py-2 text-sm text-white shadow-lg">
      <span><%= alert %></span>
      <%# Heroicon outline `x-mark`: el &times; tipográfico era el único cierre
          del sitio que no era un ícono del pack. %>
      <%# Área táctil de 44px (como el bote de basura de las partidas): el
          único cuerpo del botón era el ícono de 16px, imposible de atinar en
          tablet — y los alerts no se cierran solos, así que este botón es el
          único camino. Los márgenes negativos conservan el tamaño del pill. %>
      <button type="button" data-action="flash#dismiss" aria-label="Cerrar aviso"
              class="-my-2.5 -mr-3 flex h-11 w-11 shrink-0 items-center justify-center text-white/80 transition-colors hover:text-white">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  <% end %>
</div>
