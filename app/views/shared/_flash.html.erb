<% if notice.present? || alert.present? %>
  <div class="fixed inset-x-0 top-4 z-50 flex flex-col items-center gap-2 px-4">
    <% if notice.present? %>
      <div class="rounded-lg bg-emerald-600 px-4 py-2 text-sm text-white shadow-lg"><%= notice %></div>
    <% end %>
    <% if alert.present? %>
      <div class="rounded-lg bg-red-600 px-4 py-2 text-sm text-white shadow-lg"><%= alert %></div>
    <% end %>
  </div>
<% end %>
