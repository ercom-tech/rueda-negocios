<%# Barra superior del shell oscuro (home y reportes): logo (→ menú) + pills
    de contexto + cerrar sesión. El pill de proveedor no aplica al servidor
    (no captura pedidos). %>
<header class="flex flex-wrap items-center justify-between gap-4">
  <%= link_to root_path, title: "Volver al menú" do %>
    <%= image_tag "fecego_logo_white.png", alt: "FECEGO", class: "h-14 w-auto" %>
  <% end %>

  <div class="flex flex-wrap items-center gap-3 text-sm">
    <span class="rounded-full bg-brand-cream px-5 py-2.5 text-neutral-800">
      Usuario: <span class="font-semibold"><%= current_user.full_name.presence || current_user.username %></span>
    </span>
    <% unless current_user.can_see_all_orders? %>
      <%= render "shared/supplier_pill" %>
    <% end %>

    <%# Cerrar sesión con confirmación (decisión del usuario 2026-07-27; antes
        era acción directa): evita salidas accidentales en tablet. %>
    <div data-controller="modal" data-action="keydown@window->modal#closeOnEsc">
      <button type="button" data-action="modal#open"
              class="rounded-full bg-neutral-400 px-5 py-2.5 font-semibold text-neutral-900 transition-colors hover:bg-neutral-300">
        Cerrar sesión
      </button>
      <%= render "home/confirm_dialog", title: "Cerrar sesión",
            message: "¿Seguro que quieres cerrar la sesión?",
            confirm_label: "Sí, salir", path: logout_path, method: :delete %>
    </div>
  </div>
</header>
