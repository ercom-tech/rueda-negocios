<% content_for :title, "Revisar precios · Rueda de Negocios" %>
<%# Sin caché de Turbo: con "atrás" después de aplicar, Turbo restauraba esta
    pantalla de su copia —"Todavía no se ha cambiado nada", "Aplicar 3,306
    cambios"— sin preguntar al servidor (13ª auditoría). %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>
<%#
  Revisión del archivo de precios, con la gramática del reporte de pedidos
  capturados (decisión del usuario 2026-10-08): acciones en la fila del
  título, explicación en párrafo debajo, tarjetas crema que son TAMBIÉN
  el filtro —la coral, "Cambian", cierra la fila como el Total del reporte y es
  la vista por omisión— y UNA sola tabla paginada con el grupo elegido.
%>
<% review     = @review %>
<% applicable = review.changes.size %>
<% large      = review.large_variations.size %>
<% drafts     = review.stale_drafts %>
<%# El umbral viaja en todos los enlaces —tarjetas, paginador, CSV— para que
    cambiar de grupo o de página no lo regrese al de omisión. Se omite cuando
    es el de omisión: URLs limpias. %>
<% threshold_param = (@threshold unless @threshold == PricesController::DEFAULT_THRESHOLD) %>
<% base_params = { token: @upload.token, per_page: @pagy.limit, threshold: threshold_param }.compact %>
<% card_class = "block rounded-2xl px-5 py-4 transition-transform hover:scale-[1.015]" %>
<% rejected_group = @group == "rejected" %>

<div class="relative min-h-screen w-full overflow-hidden bg-black text-white">
  <div class="pointer-events-none absolute inset-0 bg-cover bg-center opacity-[0.18]"
       style="background-image: url('<%= image_path "tools_pattern_white.svg" %>');"></div>

  <div class="relative z-10 flex min-h-screen flex-col px-6 py-6 sm:px-10 lg:px-[5%] lg:py-8">
    <%= render "shared/top_bar" %>

    <div class="mt-8 mb-6 flex flex-wrap items-center justify-between gap-4">
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="text-3xl font-extrabold text-white sm:text-4xl">Revisar precios</h1>
        <span class="rounded-full bg-brand-gold px-3 py-1 text-xs font-semibold text-neutral-900"><%= @upload.filename %></span>
      </div>
      <%# Acciones en la fila del título (decisión del usuario 2026-10-08): en
          la barra dorada quedaban solas, con media barra vacía — aquí no hay
          filtros que la llenen, porque el filtro son las tarjetas. Sobre el
          fondo negro el secundario es `bg-white/10`, como el regreso. El
          diálogo cuelga de este wrapper, que no se transforma. %>
      <div class="flex flex-wrap items-center gap-2" data-controller="modal"
           data-action="keydown@window->modal#closeOnEsc">
        <%# Umbral de variación: decide qué se SEÑALA (tarjeta, badge, CSV),
            nunca qué se aplica. Combo de la app con el estilo del secundario
            sobre fondo negro; el panel a lo ancho de su contenido y pegado a
            la derecha, como el de los pills de contexto. %>
        <%= form_with url: server_price_review_path(@upload.token), method: :get,
              data: { controller: "form-submit" } do %>
          <%= hidden_field_tag :group, @group unless @group == "changes" %>
          <%= hidden_field_tag :per_page, @pagy.limit %>
          <%= render "shared/custom_select", name: "threshold", selected: @threshold, include_blank: false,
                options: PricesController::THRESHOLDS.map { |t| [ "Variación: #{t}%", t ] },
                label: "Variación: #{@threshold}%", input_data: { action: "change->form-submit#submit" },
                button_class: "flex items-center gap-2 rounded-full bg-white/10 px-5 py-2.5 text-sm font-semibold " \
                              "text-white transition-colors hover:bg-white/20",
                panel_class: "absolute right-0 top-full z-30 mt-1 w-max whitespace-nowrap overflow-auto " \
                             "rounded-2xl border border-black/10 bg-brand-cream text-sm shadow-xl" %>
        <% end %>
        <%= link_to server_price_review_path(@upload.token, format: :csv, threshold: threshold_param),
              title: "Descargar la revisión como CSV", aria: { label: "Descargar la revisión en CSV" },
              class: "flex items-center gap-2 rounded-full bg-white/10 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-white/20" do %>
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
          </svg>
          CSV
        <% end %>
        <% if applicable.positive? %>
          <button type="button" data-action="modal#open"
                  class="rounded-full bg-brand-coral px-5 py-2.5 text-sm font-bold text-white transition-colors hover:bg-brand-coral-dark">
            Aplicar <%= applicable == 1 ? "1 cambio" : "#{applicable.to_fs(:delimited)} cambios" %>
          </button>
          <%= render "home/confirm_dialog", title: "Aplicar precios",
                message: "Se #{applicable == 1 ? 'cambiará 1 precio' : "cambiarán #{applicable.to_fs(:delimited)} precios"}. " \
                         "Las partidas nuevas se capturarán con el precio del archivo. ¿Continuar?",
                confirm_label: "Sí, aplicar", path: server_price_review_apply_path(@upload.token) %>
        <% end %>
        <%= link_to "← Volver a cambiar precios", server_prices_path, class: back_link_class %>
      </div>
    </div>

    <%# Lo primero que el operador necesita saber —que nada se ha escrito— y
        lo que pide atención antes de aplicar, en el párrafo de los reportes. %>
    <p class="mb-6 max-w-4xl text-sm text-white/70">
      <span class="font-semibold text-white">Todavía no se ha cambiado nada.</span>
      <% if applicable.zero? %>
        No hay precios que cambiar: todos los del archivo ya son los vigentes o no se pueden aplicar.
      <% end %>
      <% if large.positive? %>
        <%= large == 1 ? "1 precio cambia" : "#{large.to_fs(:delimited)} precios cambian" %> más de <%= @threshold %>%:
        se aplican igual, revísalos por si hay un error en el archivo.
      <% end %>
      <% if drafts.any? %>
        <%= stale_drafts_sentence(drafts) %>
      <% end %>
      Los precios ya cargados de otros archivos se conservan; en un código repetido gana este archivo.
    </p>

    <%# ── Tarjetas = filtro. Volver a picar la activa regresa a "Cambian". ── %>
    <div class="mb-6 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <%# Segundo renglón: un dato que el número grande no dice —hacia dónde se
          mueven los precios, por qué no se aplican—, como el importe en las
          tarjetas del reporte. %>
      <% [ [ "large", "Variación de más de #{@threshold}%", large, price_directions_label(review.directions(review.large_variations)) ],
           [ "rejected", "No se aplican", review.rejected.size, rejected_kinds_label(review.rejected_kinds) ],
           [ "unchanged", "Quedan igual", review.unchanged.size, "Mismo precio que hoy" ] ].each do |group, label, count, note| %>
        <% active = @group == group %>
        <%= link_to server_price_review_path(@upload.token, group: (active ? nil : group), per_page: @pagy.limit,
                                             threshold: threshold_param),
              aria: { current: (active ? "true" : nil) },
              class: "#{card_class} bg-brand-cream text-neutral-900 #{'ring-4 ring-brand-gold' if active}" do %>
          <div class="flex items-center justify-between gap-3">
            <span class="rounded-full bg-neutral-700 px-3 py-1 text-xs font-semibold text-white"><%= label %></span>
            <span class="text-3xl font-extrabold tabular-nums"><%= count.to_fs(:delimited) %></span>
          </div>
          <p class="mt-2 text-lg font-semibold"><%= note %></p>
          <p class="mt-1 text-xs font-semibold text-neutral-600"><%= active ? "Quitar filtro" : "Ver solo estos" %></p>
        <% end %>
      <% end %>

      <%= link_to server_price_review_path(@upload.token, per_page: @pagy.limit, threshold: threshold_param),
            aria: { current: (@group == "changes" ? "true" : nil) },
            class: "#{card_class} bg-brand-coral text-white #{'ring-4 ring-brand-gold' if @group == 'changes'}" do %>
        <div class="flex items-center justify-between gap-3">
          <%# coral-dark y no `bg-white/20`: blanco de 12 px sobre el coral
              aclarado daba 3.35:1, bajo el 4.5 de AA (13ª auditoría). %>
          <span class="rounded-full bg-brand-coral-dark px-3 py-1 text-xs font-semibold">Cambian</span>
          <span class="text-3xl font-extrabold tabular-nums"><%= applicable.to_fs(:delimited) %></span>
        </div>
        <p class="mt-2 text-lg font-bold"><%= price_directions_label(review.directions(review.changes)) %></p>
      <% end %>
    </div>

    <div class="overflow-x-auto rounded-3xl border border-black/10 bg-brand-cream text-neutral-900"
         tabindex="0" role="region" aria-label="Precios del archivo">
      <table class="w-full text-sm">
        <thead class="bg-black text-white">
          <tr>
            <th class="px-4 py-3 text-right font-semibold">Línea</th>
            <th class="px-4 py-3 text-left font-semibold">Código</th>
            <% if rejected_group %>
              <th class="min-w-[18rem] px-4 py-3 text-left font-semibold">Motivo</th>
            <% else %>
              <th class="min-w-[18rem] px-4 py-3 text-left font-semibold">Descripción</th>
              <th class="px-4 py-3 text-right font-semibold whitespace-nowrap">Precio actual</th>
              <th class="px-4 py-3 text-right font-semibold whitespace-nowrap">Precio nuevo</th>
              <th class="px-4 py-3 text-right font-semibold">Variación</th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% @rows.each do |row| %>
            <tr class="border-t border-black/10">
              <td class="px-4 py-3 text-right tabular-nums text-neutral-600"><%= row.line %></td>
              <% if rejected_group %>
                <td class="px-4 py-3 font-semibold tabular-nums"><%= row.code_text.presence || "—" %></td>
                <td class="min-w-[18rem] px-4 py-3"><%= row.reason %></td>
              <% else %>
                <td class="px-4 py-3 font-semibold tabular-nums"><%= Product.erp_code_for(row.code) %></td>
                <td class="min-w-[18rem] px-4 py-3"><%= row.description %></td>
                <td class="px-4 py-3 text-right tabular-nums whitespace-nowrap"><%= row.current_price ? number_to_currency(row.current_price) : "Sin precio" %></td>
                <td class="px-4 py-3 text-right font-semibold tabular-nums whitespace-nowrap"><%= number_to_currency(row.new_price) %></td>
                <td class="px-4 py-3 text-right tabular-nums whitespace-nowrap">
                  <%= PriceList.variation_label(row.variation) || "—" %>
                  <%# En "Cambian" el badge separa las grandes de las demás; en
                      su propio grupo todas lo son y sobraría. %>
                  <% if @group == "changes" && @review.large?(row) %>
                    <span class="ml-1 rounded-full bg-neutral-700 px-2 py-0.5 text-xs font-semibold text-white">Revisar</span>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>

          <% if @rows.empty? %>
            <tr>
              <td colspan="<%= rejected_group ? 3 : 6 %>" class="px-4 py-10 text-center text-neutral-600">
                Ningún renglón del archivo cae en este grupo.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%# En "No se aplican" son renglones rechazados, no precios (muchos ni lo
        traen). "rechazo" y "precio" pluralizan bien con `pluralize`. %>
    <%= render "shared/paginator", pagy: @pagy, noun: (@group == "rejected" ? "rechazo" : "precio"),
          base_params: base_params.merge(group: (@group unless @group == "changes")).compact,
          page_sizes: @page_sizes %>
  </div>
</div>
