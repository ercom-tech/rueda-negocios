<%# Sugerencias del buscador de producto, acotadas al universo del capturista.
    Locals: order, products, no_membership (sin proveedores/marcas asignados). %>
<% if local_assigns[:no_membership] %>
  <div role="alert" class="rounded-2xl border border-black/10 bg-brand-cream px-5 py-3 text-sm text-red-600 shadow-xl">
    No tienes proveedores o marcas asignados en esta rueda; no puedes agregar
    productos. Pide al equipo del servidor actualizar la información.
  </div>
<% elsif products.any? %>
  <%# Qué producto ya está en el pedido, y en qué partida. Sin esto, la
      sugerencia de uno ya agregado se veía IDÉNTICA a la de uno nuevo: con la
      tabla scrolleando y 45 renglones posibles, el duplicado no se notaba y el
      pedido llegaba al ERP con dos renglones del mismo producto — se surte
      doble. No se bloquea (un mismo producto con distinto descuento es
      legítimo); se avisa antes, y el controlador lo repite después. %>
  <% already_in = order.order_items.where.not(product_id: nil).pluck(:product_id, :position).to_h %>
  <ul class="max-h-80 overflow-auto rounded-2xl border border-black/10 bg-brand-cream shadow-xl">
    <% products.each do |product| %>
      <% existing_position = already_in[product.id] %>
      <li>
        <%= button_to order_order_items_path(order, product_id: product.id),
              class: "flex w-full items-center justify-between gap-4 px-5 py-3 text-left hover:bg-black/5" do %>
          <span>
            <span class="font-semibold text-neutral-900"><%= product.description %></span>
            <%# Solo los datos que existen: modelo/N.P vacíos no dejan rótulos
                huérfanos ("Modelo ·"). %>
            <span class="block text-xs text-neutral-600">
              <%= safe_join([
                    "Código #{product.erp_code}",
                    product.model.presence && "Modelo #{product.model}",
                    product.part_number.presence && "N/P #{product.part_number}",
                    number_to_currency(product.price&.public_price)
                  ].compact, " · ") %>
            </span>
            <% if existing_position %>
              <span class="mt-1 block text-xs font-semibold text-brand-coral-dark">
                Ya está en el pedido, partida <%= existing_position %>
              </span>
            <% end %>
          </span>
          <span class="shrink-0 rounded-full bg-black px-3 py-1 text-xs font-semibold text-white">
            <%= existing_position ? "Agregar otra vez" : "Agregar" %>
          </span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <div class="rounded-2xl border border-black/10 bg-brand-cream px-5 py-3 text-sm text-neutral-600 shadow-xl">
    Sin resultados.
  </div>
<% end %>
