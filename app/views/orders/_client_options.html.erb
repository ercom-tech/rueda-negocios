<%# Sugerencias del autocompletado. Locals: clients; order (opcional, si se está
    editando un pedido → el cambio de cliente recae sobre el mismo pedido). %>
<% if clients.any? %>
  <%# `max-h-80 overflow-auto` como los buscadores de producto: con
      Client::SEARCH_LIMIT sugerencias el panel mide ~3,600 px, y el shell
      lleva overflow-hidden (contiene el patrón), así que sin tope se recorta
      SIN scroll con el que llegar al resto — y lo primero que se pierde es el
      aviso de corte, que va debajo. Con 10 sugerencias no se notaba (8ª aud.). %>
  <ul id="client-search-listbox" role="listbox" aria-label="Resultados de cliente"
      class="max-h-80 overflow-auto rounded-2xl border border-black/10 bg-brand-cream shadow-xl">
    <% clients.each do |c| %>
      <li>
        <%= link_to (order ? edit_order_path(order, client_key: c.erp_client_key) : new_order_path(client_key: c.erp_client_key)),
              class: "flex items-center justify-between gap-4 px-5 py-3 hover:bg-black/5" do %>
          <span>
            <span class="flex flex-wrap items-baseline gap-x-2">
              <span class="font-semibold text-neutral-900"><%= c.commercial_name.presence || c.name %></span>
              <% if c.commercial_name.present? && c.name.present? %>
                <span class="text-sm text-neutral-600"><%= c.name %></span>
              <% end %>
            </span>
            <span class="block text-xs text-neutral-600">Vendedor: <%= c.salesperson&.name || "—" %></span>
          </span>
          <span class="shrink-0 rounded-full bg-black px-3 py-1 text-xs font-semibold text-white"><%= c.erp_client_key %></span>
        <% end %>
      </li>
    <% end %>
  </ul>
  <%# El corte no puede ser silencioso: con Client::SEARCH_LIMIT sugerencias y
      sin aviso, "no está" y "quedó en el puesto siguiente" se ven igual, y el
      capturista no sabe si refinar la búsqueda o capturarlo fuera de catálogo.
      Va FUERA del listbox —que es el <ul> de arriba, no el contenedor— porque
      `listbox` solo admite hijos `option`/`group`: un <p> dentro lo filtran
      varios lectores de pantalla, que es justo el ruido que se quería evitar.
      Antes el role vivía en el div contenedor y el partial ENTERO se inyecta
      ahí, así que el aviso caía dentro sin que se notara (8ª auditoría).
      Y aquí queda siempre a la vista, debajo del área con scroll. %>
  <% if local_assigns[:truncated] %>
    <p role="status" class="mt-1 rounded-xl border border-black/10 bg-brand-cream px-5 py-2 text-xs font-semibold text-neutral-700 shadow-xl">
      Se muestran las primeras <%= Client::SEARCH_LIMIT %> coincidencias. Si no ves la que buscas, escribe más letras.
    </p>
  <% end %>
<% else %>
  <div class="rounded-2xl border border-black/10 bg-brand-cream px-5 py-3 text-sm text-neutral-600 shadow-xl">
    Sin resultados.
  </div>
<% end %>
