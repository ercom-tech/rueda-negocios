<% content_for :title, "Levantamiento de pedido · Rueda de Negocios" %>

<div class="relative min-h-screen w-full overflow-hidden bg-brand-cream text-neutral-900">
  <div class="pointer-events-none absolute inset-0 bg-cover bg-center opacity-[0.12]"
       style="background-image: url('<%= image_path "tools_pattern_black.svg" %>');"></div>

  <header class="relative z-10 flex items-center justify-between bg-brand-gold px-6 py-4 sm:px-10 lg:px-[7%]">
    <h1 class="text-2xl font-extrabold sm:text-3xl">Levantamiento de pedido</h1>
    <%= link_to root_path, title: "Volver al menú" do %>
      <%= image_tag "fecego_logo_white.png", alt: "FECEGO", class: "h-9 w-auto invert" %>
    <% end %>
  </header>

  <div class="relative z-10 w-full space-y-6 px-6 py-8 lg:px-[7%]">
    <%# ── Barra: # Pedido + acciones ── %>
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <span class="rounded-full bg-neutral-400/80 px-5 py-2.5 text-sm font-semibold text-neutral-900">
          # Pedido <%= @order.erp_folio.presence || @order.local_folio.presence || "(borrador)" %>
        </span>
        <span class="rounded-full px-4 py-2.5 text-sm font-semibold <%= @order.status_color %>">
          <%= @order.status_label %>
        </span>
      </div>
      <div class="flex items-center gap-3">
        <% if can_edit_order?(@order) %>
          <%= link_to "Editar", edit_order_path(@order),
                class: "rounded-full bg-brand-gold px-6 py-2.5 font-bold text-neutral-900 hover:bg-brand-gold-dark" %>
          <div class="inline-block" data-controller="modal" data-action="keydown@window->modal#closeOnEsc">
            <button type="button" data-action="modal#open"
                    class="rounded-full bg-brand-gold px-6 py-2.5 font-bold text-neutral-900 hover:bg-brand-gold-dark">Cancelar</button>
            <%= render "home/confirm_dialog", title: "Descartar pedido",
                  message: "Se descartará este pedido en captura y no se guardará. ¿Continuar?",
                  confirm_label: "Sí, descartar", path: order_path(@order), method: :delete %>
          </div>
          <%= link_to "Finalizar pedido", capture_order_path(@order), data: { turbo_method: :post },
                class: "rounded-full bg-brand-coral px-6 py-2.5 font-bold text-white hover:bg-brand-coral-dark" %>
        <% else %>
          <%= link_to "Descargar PDF", pdf_order_path(@order),
                class: "rounded-full bg-black px-6 py-2.5 font-bold text-white hover:bg-neutral-800" %>
          <%= link_to "Volver al menú", root_path,
                class: "rounded-full bg-brand-gold px-6 py-2.5 font-bold text-neutral-900 hover:bg-brand-gold-dark" %>
        <% end %>
      </div>
    </div>

    <%# ── Resumen del encabezado (solo lectura) — 4 columnas × 2 filas ── %>
    <div class="grid grid-cols-2 gap-x-6 gap-y-4 rounded-2xl bg-black p-5 text-sm text-white sm:grid-cols-4">
      <%# Fila 1 %>
      <div>
        <span class="block text-xs text-white/50">Clave del cliente</span>
        <span class="font-semibold"><%= @order.client.erp_client_key %></span>
      </div>
      <div>
        <span class="block text-xs text-white/50">Nombre comercial</span>
        <span class="font-semibold"><%= @order.client.commercial_name.presence || "—" %></span>
      </div>
      <div>
        <span class="block text-xs text-white/50">Nombre / razón social</span>
        <span class="font-semibold"><%= (@order.invoice? ? @order.client_tax_profile&.business_name : @order.client.name).presence || "—" %></span>
      </div>
      <div>
        <span class="block text-xs text-white/50">Vendedor</span>
        <span class="font-semibold"><%= @order.client.salesperson&.name || "—" %></span>
      </div>

      <%# Fila 2 %>
      <div>
        <span class="block text-xs text-white/50">Tipo</span>
        <span class="font-semibold"><%= @order.invoice? ? "Factura" : "Remisión" %></span>
      </div>
      <div>
        <span class="block text-xs text-white/50">Uso de CFDI</span>
        <span class="font-semibold"><%= @order.invoice? ? (@order.cfdi_use&.code || "—") : "—" %></span>
      </div>
      <div class="hidden sm:block"></div>
      <div>
        <span class="block text-xs text-white/50">Dirección de entrega</span>
        <span class="font-semibold"><%= @order.client_branch&.name || "—" %></span>
      </div>
    </div>

    <%# ── Buscador de producto (autocompletado) — solo si el dueño puede editar ── %>
    <% if can_edit_order?(@order) %>
      <div class="relative" data-controller="autocomplete"
           data-autocomplete-url-value="<%= product_options_order_path(@order) %>"
           data-action="click@window->autocomplete#hide turbo:submit-end->autocomplete#reset">
        <div class="flex items-center gap-3 rounded-full bg-black px-5 py-3 text-white">
          <span aria-hidden="true">🔍</span>
          <input type="text" autocomplete="off"
                 placeholder="Busca por código, nombre, modelo o No. de parte"
                 role="combobox" aria-autocomplete="list" aria-expanded="false"
                 aria-controls="product-search-results" aria-label="Buscar producto"
                 data-autocomplete-target="input"
                 data-action="input->autocomplete#search keydown->autocomplete#navigate"
                 class="w-full bg-transparent outline-none placeholder:text-white/60" />
        </div>
        <div id="product-search-results" role="listbox" aria-label="Resultados de producto"
             data-autocomplete-target="results"
             class="absolute inset-x-0 top-full z-20 mt-1"></div>
      </div>
    <% end %>

    <%# ── Tabla de partidas (Turbo) ── %>
    <%= render "items_table", order: @order %>

    <%# ── Observaciones (izquierda) + Totales (derecha) ── %>
    <div class="flex flex-col gap-6 lg:flex-row lg:items-stretch">
      <% if can_edit_order?(@order) %>
        <%= form_with url: observations_order_path(@order), method: :patch,
              data: { controller: "form-submit", action: "turbo:submit-end->form-submit#flashStatus" },
              class: "flex flex-1 flex-col" do %>
          <%= text_area_tag :observations, @order.observations,
                placeholder: "Observaciones", "aria-label": "Observaciones del pedido",
                data: { action: "change->form-submit#submit" },
                class: "h-full min-h-32 w-full rounded-2xl border border-black/10 bg-white p-4 outline-none placeholder:text-neutral-500 focus:border-brand-gold" %>
          <span data-form-submit-target="status" role="status"
                class="mt-1 self-end text-sm font-semibold text-emerald-700 opacity-0 transition-opacity duration-300">
            Guardado ✓
          </span>
        <% end %>
      <% else %>
        <div class="min-h-32 flex-1 whitespace-pre-line rounded-2xl border border-black/10 bg-white p-4 text-neutral-700">
          <%= @order.observations.presence || "Sin observaciones." %>
        </div>
      <% end %>

      <%= render "totals", order: @order %>
    </div>
  </div>
</div>
