<% content_for :title, "Levantamiento de pedido · Rueda de Negocios" %>

<div class="relative min-h-screen w-full overflow-hidden bg-black">
  <%# Patrón de herramientas a todo lo ancho (mismo shell que el home) %>
  <div class="pointer-events-none absolute inset-0 bg-cover bg-center opacity-[0.18]"
       style="background-image: url('<%= image_path "tools_pattern_white.svg" %>');"></div>

  <%# Ni este wrapper ni el del contenido llevan z-index, A PROPÓSITO: los dos
      contienen modales (cerrar sesión aquí, promociones abajo) y un z-index
      sobre un `relative` crea contexto de apilamiento — el `z-50` del diálogo
      deja de contar contra el resto de la página y solo compite dentro de su
      wrapper. Así estaba antes (header z-20, contenido z-10) y el header se
      pintaba ENCIMA del modal de promoción: un toque cerca del borde superior
      del modal caía en "Cerrar sesión" y sacaba al capturista a media captura
      (7ª auditoría).
      Sin z-index, los dos siguen tapando al patrón de fondo —van después en el
      DOM y el patrón no está posicionado por encima— y los diálogos `fixed
      z-50` compiten en el contexto raíz, que es donde deben ganar. %>
  <div class="relative px-6 pt-6 sm:px-10 lg:px-[5%] lg:pt-8">
    <%= render "shared/top_bar" %>
    <%# El regreso va en la fila del título, como en el resto del sitio, y es
        UNO solo: al reporte si se llegó desde ahí (conservando sus filtros, su
        estatus y su página — rearmarlos a mano en cada pedido revisado es justo
        lo que se hace antes de transmitir), al menú si no. La barra de la card
        se queda con las acciones. %>
    <div class="mt-8 flex flex-wrap items-center justify-between gap-4">
      <h1 class="text-3xl font-extrabold text-white sm:text-4xl">Levantamiento de pedido</h1>
      <% if report_back_path %>
        <%= link_to "← Volver al reporte", report_back_path, class: back_link_class %>
      <% else %>
        <%= link_to "← Volver al menú", root_path, class: back_link_class %>
      <% end %>
    </div>
  </div>

  <%# ── Card dorada única (misma gramática que los pasos 1 y 3): barra negra
      de título, contenido adentro y botones al pie ── %>
  <%# Sin z-index: ver la nota del wrapper de arriba. %>
  <div class="relative w-full px-6 py-8 lg:px-[5%]">
    <section class="rounded-3xl bg-brand-gold p-2">
      <%# Barra de título: folio + estatus a la izquierda, acciones a la derecha %>
      <div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl bg-black px-6 py-3">
        <div class="flex flex-wrap items-center gap-3">
          <h2 class="text-xl font-extrabold text-white sm:text-2xl">
            # Pedido <%= @order.folio %>
          </h2>
          <span class="rounded-full px-4 py-1.5 text-sm font-semibold <%= @order.status_color %>">
            <%= @order.status_label %>
          </span>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <% if can_edit_order?(@order) %>
            <%= link_to "Editar", edit_order_path(@order),
                  class: "rounded-full bg-neutral-700 px-6 py-2.5 font-bold text-white transition-colors hover:bg-neutral-600" %>
            <div class="inline-block" data-controller="modal" data-action="keydown@window->modal#closeOnEsc">
              <%# "Descartar", no "Cancelar": mismo verbo que el modal que abre
                  (título, "Sí, descartar" y flash "Pedido descartado") — y el
                  modal tiene su propio "Cancelar" que significa lo contrario. %>
              <button type="button" data-action="modal#open"
                      class="rounded-full bg-neutral-700 px-6 py-2.5 font-bold text-white transition-colors hover:bg-neutral-600">Descartar</button>
              <%# Mensaje según estatus: un borrador se descarta; un capturado ya
                  está guardado con folio — se elimina con sus partidas. %>
              <%= render "home/confirm_dialog", title: "Descartar pedido",
                    message: (@order.draft? ? "Se descartará este pedido en captura y no se guardará. ¿Continuar?"
                                            : "Se eliminará el pedido #{@order.folio} con todas sus partidas. ¿Continuar?"),
                    confirm_label: "Sí, descartar", path: order_path(@order), method: :delete %>
            </div>
            <% if @order.draft? %>
              <%# button_to (form real) y no link con turbo_method: el intercept
                  del link fallaba en silencio (no emitía el POST). %>
              <%= button_to "Finalizar pedido", capture_order_path(@order),
                    form_class: "inline-block",
                    class: "cursor-pointer rounded-full bg-brand-coral px-6 py-2.5 font-bold text-white transition-colors hover:bg-brand-coral-dark" %>
            <% else %>
              <%# Ya está capturado: el coral lleva al resumen (ahí vive el
                  PDF), no a "finalizarlo" otra vez — con ese rótulo, llegar
                  al PDF del cliente exigía tocar un botón que mentía. %>
              <%= link_to "Ir al resumen", summary_order_path(@order),
                    class: "inline-block rounded-full bg-brand-coral px-6 py-2.5 font-bold text-white transition-colors hover:bg-brand-coral-dark" %>
            <% end %>
          <% else %>
            <%= link_to "Descargar PDF", pdf_order_path(@order),
                  class: "rounded-full bg-brand-gold px-6 py-2.5 font-bold text-neutral-900 transition-colors hover:bg-brand-gold-dark" %>
          <% end %>
        </div>
      </div>

      <div class="mt-2 space-y-2">
        <%# ── Resumen del encabezado (solo lectura) — 4 columnas × 2 filas ── %>
        <div class="grid grid-cols-2 gap-x-6 gap-y-4 rounded-2xl bg-black p-5 text-sm text-white sm:grid-cols-4">
          <%# Fila 1 %>
          <div>
            <span class="block text-xs text-white/50">Clave del cliente</span>
            <span class="font-semibold"><%= @order.client.erp_client_key %></span>
          </div>
          <div>
            <span class="block text-xs text-white/50">Nombre comercial</span>
            <span class="font-semibold"><%= @order.client.commercial_name.presence || "—" %></span>
          </div>
          <div>
            <span class="block text-xs text-white/50">Nombre / razón social</span>
            <%# En factura, con RFC incluido (label = "RFC — razón social",
                como el combo del paso 1). %>
            <span class="font-semibold"><%= (@order.invoice? ? @order.client_tax_profile&.label : @order.client.name).presence || "—" %></span>
          </div>
          <div>
            <span class="block text-xs text-white/50">Vendedor</span>
            <span class="font-semibold"><%= @order.client.salesperson&.name || "—" %></span>
          </div>

          <%# Fila 2 %>
          <div>
            <span class="block text-xs text-white/50">Tipo</span>
            <span class="font-semibold"><%= @order.invoice? ? "Factura" : "Remisión" %></span>
          </div>
          <div>
            <span class="block text-xs text-white/50">Uso de CFDI</span>
            <span class="font-semibold"><%= @order.invoice? ? (@order.cfdi_use&.label || "—") : "—" %></span>
          </div>
          <div>
            <span class="block text-xs text-white/50">Dividir facturas</span>
            <span class="font-semibold">
              <%= @order.invoice? ? (@order.dividir_facturas.positive? ? "cada #{number_to_currency(@order.dividir_facturas)}" : "No dividir") : "—" %>
            </span>
          </div>
          <div>
            <span class="block text-xs text-white/50">Dirección de entrega</span>
            <span class="font-semibold"><%= @order.client_branch&.label || "—" %></span>
          </div>
        </div>

        <%# ── Buscador de producto (autocompletado) — solo si el dueño puede editar ── %>
        <% if can_edit_order?(@order) %>
          <%= render "product_search", order: @order %>
        <% end %>

        <%# ── Tabla de partidas (Turbo) ── %>
        <%= render "items_table", order: @order %>

        <%# Destino de los streams que mueven el foco (ver OrderItems#destroy). %>
        <%= render "focus_director" %>

        <%# ── Observaciones (izquierda) + Totales (derecha) ── %>
        <div class="flex flex-col gap-2 lg:flex-row lg:items-stretch">
          <% if can_edit_order?(@order) %>
            <%# El "Guardado ✓" va como overlay DENTRO del textarea (absolute):
                si viviera debajo, el textarea quedaría más corto que la card de
                totales y las alturas no empatarían. %>
            <%= form_with url: observations_order_path(@order), method: :patch,
                  data: { controller: "form-submit", action: "turbo:submit-end->form-submit#flashStatus" },
                  class: "relative flex flex-1 flex-col" do %>
              <%# `uppercase` es solo presentación (se ve en mayúsculas al
                  teclear); el valor real lo normaliza el modelo (normalizes). %>
              <%# Blanco, no crema: el blanco es la señal de "esto se escribe"
                  (convenciones-visuales). En crema, el textarea editable se veía
                  idéntico al bloque de solo lectura de abajo —mismo color, mismo
                  radio, mismo borde— y el capturista no sabía si podía escribir
                  hasta hacer clic. %>
              <%# `remember` guarda el valor al entrar: si el envío falla (la
                  pausa de sync responde 422), el campo revierte a lo guardado
                  en vez de quedarse mintiendo con lo tecleado. %>
              <%= text_area_tag :observations, @order.observations,
                    placeholder: "Observaciones", "aria-label": "Observaciones del pedido",
                    data: { action: "focus->form-submit#remember change->form-submit#submit" },
                    class: "h-full min-h-32 w-full rounded-2xl border border-black/10 bg-white p-4 uppercase text-neutral-900 outline-none placeholder:normal-case placeholder:text-neutral-500 focus:border-brand-gold-dark" %>
              <span data-form-submit-target="status" role="status"
                    class="pointer-events-none absolute bottom-3 right-4 text-sm font-semibold text-neutral-900 opacity-0 transition-opacity duration-300">
                Guardado ✓
              </span>
            <% end %>
          <% else %>
            <div class="min-h-32 flex-1 whitespace-pre-line rounded-2xl border border-black/10 bg-brand-cream p-4 text-neutral-700">
              <%= @order.observations.presence || "Sin observaciones." %>
            </div>
          <% end %>

          <%= render "totals", order: @order %>
        </div>
      </div>

    </section>
  </div>
</div>
