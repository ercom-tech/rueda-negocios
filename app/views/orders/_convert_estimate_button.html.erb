<%# "Convertir en pedido" (decisión del usuario 2026-11-04). Locals: order (la
    cotización GUARDADA); row (true en el resumen, con la forma de los
    renglones de "Descargar PDF"; si no, píldora de la barra del detalle).

    Con cliente se convierte directo, desde un modal: crea el pedido YA
    guardado —sale en la siguiente transmisión— y borra la cotización, así
    que se pide confirmar. La genérica va primero al paso 1 a elegir cliente. %>
<% row   = local_assigns[:row] %>
<% count = order.order_items.size %>
<% items = count == 1 ? "la partida" : "las #{count} partidas" %>
<% css   = row ? "flex w-full cursor-pointer items-center gap-4 rounded-2xl bg-black px-6 py-5 text-left text-lg font-semibold text-white transition-colors hover:bg-neutral-800"
               : "cursor-pointer rounded-full bg-brand-gold px-6 py-2.5 font-bold text-neutral-900 transition-colors hover:bg-brand-gold-dark" %>
<% icon = capture do %>
  <%# Heroicons outline: arrow-path-rounded-square %>
  <svg class="h-8 w-8 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12c0-1.232-.046-2.453-.138-3.662a4.006 4.006 0 0 0-3.7-3.7 48.678 48.678 0 0 0-7.324 0 4.006 4.006 0 0 0-3.7 3.7c-.017.22-.032.441-.046.662M19.5 12l3-3m-3 3-3-3m-12 3c0 1.232.046 2.453.138 3.662a4.006 4.006 0 0 0 3.7 3.7 48.656 48.656 0 0 0 7.324 0 4.006 4.006 0 0 0 3.7-3.7c.017-.22.032-.441.046-.662M4.5 12l3 3m-3-3-3 3" /></svg>
<% end %>

<% if order.generic? %>
  <%= link_to conversion_order_path(order), class: css do %>
    <%= icon if row %>Convertir en pedido
  <% end %>
<% else %>
  <div class="<%= row ? "block" : "inline-block" %>" data-controller="modal" data-action="keydown@window->modal#closeOnEsc">
    <button type="button" data-action="modal#open" class="<%= css %>">
      <%= icon if row %>Convertir en pedido
    </button>
    <%= render "home/confirm_dialog", title: "Convertir en pedido",
          message: "Se creará el pedido de (#{order.client.erp_client_key}) " \
                   "#{order.client.commercial_name.presence || order.client.name} con #{items} de esta " \
                   "cotización, ya guardado: se enviará al ERP en la siguiente transmisión. " \
                   "La cotización #{order.folio} se eliminará. ¿Continuar?",
          confirm_label: "Sí, convertir", path: convert_order_path(order), method: :post %>
  </div>
<% end %>
