<%# Mini-formulario del producto fuera de catálogo (genérico 999999): la
    partida no puede nacer sin descripción ni precio, así que se capturan
    ANTES de agregarla. Vive en el panel de resultados del buscador (se
    cierra igual: clic fuera o seguir tecleando). Reaparece con lo tecleado
    si la validación rechaza (local `item` presente).
    Locals: order, product, item (OrderItem inválido o nil). %>
<div class="rounded-2xl border border-black/10 bg-brand-cream p-5 shadow-xl">
  <p class="text-sm font-bold text-neutral-900">Producto fuera de catálogo (999999)</p>
  <%# El tope no es nuestro: descripción y parte viajan juntos al ERP en un
      campo de 40 caracteres (nombre_capturado). Decirlo aquí evita el
      ping-pong con el mensaje de validación. %>
  <p class="mt-1 text-xs text-neutral-600">
    La descripción y el número de parte viajan juntos al ERP:
    máximo <%= OrderItem::ERP_CAPTURED_NAME_LIMIT %> caracteres entre ambos.
  </p>

  <%= form_with url: order_order_items_path(order), method: :post,
        class: "mt-3 space-y-3" do %>
    <%= hidden_field_tag :product_id, product.id %>

    <div>
      <label for="generic_description" class="block text-xs font-semibold uppercase tracking-wide text-neutral-700">Descripción</label>
      <%= text_field_tag "generic[description]", item&.description,
            id: "generic_description", maxlength: OrderItem::ERP_CAPTURED_NAME_LIMIT,
            autofocus: true, autocomplete: "off",
            class: "mt-1 w-full rounded-lg border border-neutral-300 bg-white px-3 py-2 uppercase text-neutral-900 outline-none focus:border-brand-gold" %>
    </div>

    <div class="flex gap-3">
      <div class="flex-1">
        <label for="generic_part_number" class="block text-xs font-semibold uppercase tracking-wide text-neutral-700">No. de parte (opcional)</label>
        <%= text_field_tag "generic[part_number]", item&.part_number,
              id: "generic_part_number", maxlength: OrderItem::ERP_CAPTURED_NAME_LIMIT,
              autocomplete: "off",
              class: "mt-1 w-full rounded-lg border border-neutral-300 bg-white px-3 py-2 uppercase text-neutral-900 outline-none focus:border-brand-gold" %>
      </div>
      <div class="w-36">
        <label for="generic_unit_price" class="block text-xs font-semibold uppercase tracking-wide text-neutral-700">Precio unitario</label>
        <%= number_field_tag "generic[unit_price]", item&.unit_price,
              id: "generic_unit_price", step: "any", min: "0.01",
              class: "mt-1 w-full rounded-lg border border-neutral-300 bg-white px-3 py-2 text-right text-neutral-900 outline-none focus:border-brand-gold" %>
      </div>
    </div>

    <div class="flex justify-end">
      <button type="submit"
              class="cursor-pointer rounded-full bg-brand-coral px-6 py-2.5 font-bold text-white transition-colors hover:bg-brand-coral-dark">
        Agregar al pedido
      </button>
    </div>
  <% end %>
</div>
