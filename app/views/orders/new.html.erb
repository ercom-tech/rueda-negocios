<% content_for :title, "Levantamiento de pedido · Rueda de Negocios" %>

<div class="relative min-h-screen w-full overflow-hidden bg-brand-cream text-neutral-900">
  <%# Patrón de herramientas (negro, tenue) sobre el fondo claro %>
  <div class="pointer-events-none absolute inset-0 bg-cover bg-center opacity-[0.12]"
       style="background-image: url('<%= image_path "tools_pattern_black.svg" %>');"></div>

  <%# ── Header amarillo ── %>
  <header class="relative z-10 flex items-center justify-between bg-brand-gold px-6 py-4 sm:px-10 lg:px-[7%]">
    <h1 class="text-2xl font-extrabold sm:text-3xl">Levantamiento de pedido</h1>
    <%= link_to root_path, title: "Volver al menú" do %>
      <%= image_tag "fecego_logo_white.png", alt: "FECEGO", class: "h-9 w-auto invert" %>
    <% end %>
  </header>

  <%# ── Card única (ancha): Datos del cliente ── %>
  <div class="relative z-10 mx-auto max-w-5xl px-6 py-10 lg:px-[7%]">
    <section class="rounded-3xl bg-brand-gold p-6 sm:p-8">
      <div class="rounded-2xl bg-black py-4 text-center">
        <h2 class="text-2xl font-extrabold text-white">Datos del cliente</h2>
      </div>

      <div class="mt-6 space-y-5">
        <%# Buscador de cliente con autocompletado (clave o nombre) %>
        <div class="relative" data-controller="autocomplete"
             data-autocomplete-url-value="<%= client_options_orders_path(order_id: @order.persisted? ? @order.id : nil) %>"
             data-action="click@window->autocomplete#hide">
          <%= form_with url: (@order.persisted? ? edit_order_path(@order) : new_order_path), method: :get do %>
            <div class="flex items-center gap-3 rounded-full bg-black px-5 py-3 text-white">
              <span aria-hidden="true">🔍</span>
              <%= text_field_tag :client_key, (@client ? "#{@client.erp_client_key} - #{@client.commercial_name.presence || @client.name}" : nil),
                    placeholder: "Buscar cliente por clave o nombre",
                    autocomplete: "off",
                    data: { autocomplete_target: "input", action: "input->autocomplete#search keydown->autocomplete#navigate" },
                    class: "w-full bg-transparent outline-none placeholder:text-white/60" %>
            </div>
          <% end %>
          <div data-autocomplete-target="results" class="absolute inset-x-0 top-full z-20 mt-1"></div>
        </div>

        <% if @client %>
          <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 text-sm text-neutral-700">
            <span>Cliente: <span class="font-semibold"><%= @client.name %></span></span>
            <span>Vendedor: <span class="font-semibold"><%= @client.salesperson&.name || "—" %></span></span>
          </div>

          <%= form_with model: @order,
                data: { controller: "order-kind" }, class: "space-y-5" do |f| %>
            <%= f.hidden_field :client_id, value: @client.id %>

            <%# Resumen de campos faltantes tras un submit inválido %>
            <% if @order.errors.any? %>
              <% field_labels = { "cfdi_use_id" => "Uso de CFDI", "client_tax_profile_id" => "Nombre o razón social",
                                  "client_receipt_profile_id" => "Remisión", "client_branch_id" => "Dirección de entrega" } %>
              <div class="rounded-2xl bg-brand-coral px-5 py-3 text-sm font-semibold text-white">
                Faltan datos obligatorios:
                <%= @order.errors.attribute_names.map { |a| field_labels[a.to_s] || a.to_s.humanize }.uniq.join(", ") %>.
              </div>
            <% end %>

            <%# Fila: Tipo (Factura/Remisión) + Uso de CFDI %>
            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
              <div>
                <span class="mb-1 block text-sm font-semibold">Tipo de pedido</span>
                <div class="flex items-center gap-6 rounded-full bg-black px-6 py-3 text-white">
                  <label class="flex cursor-pointer items-center gap-2">
                    <%= f.radio_button :kind, "invoice", class: "accent-brand-gold",
                          data: { action: "change->order-kind#toggle" } %> Factura
                  </label>
                  <label class="flex cursor-pointer items-center gap-2">
                    <%= f.radio_button :kind, "remission", class: "accent-brand-gold",
                          data: { action: "change->order-kind#toggle" } %> Remisión
                  </label>
                </div>
              </div>

              <div data-order-kind-target="invoice">
                <span class="mb-1 block text-sm font-semibold text-neutral-900">Uso de CFDI</span>
                <%= render "shared/custom_select", name: "order[cfdi_use_id]", filterable: true,
                      invalid: @order.errors[:cfdi_use_id].any?,
                      options: @cfdi_uses.map { |c| [c.label, c.id] }, selected: @order.cfdi_use_id %>
              </div>
            </div>

            <%# Línea completa: Nombre o razón social (Factura) / Remisión %>
            <div data-order-kind-target="invoice">
              <span class="mb-1 block text-sm font-semibold text-neutral-900">Nombre o razón social (RFC)</span>
              <%= render "shared/custom_select", name: "order[client_tax_profile_id]",
                    invalid: @order.errors[:client_tax_profile_id].any?,
                    options: @client.tax_profiles.map { |t| [t.label, t.id] }, selected: @order.client_tax_profile_id %>
            </div>

            <div data-order-kind-target="remission">
              <span class="mb-1 block text-sm font-semibold text-neutral-900">Remisión</span>
              <%= render "shared/custom_select", name: "order[client_receipt_profile_id]",
                    invalid: @order.errors[:client_receipt_profile_id].any?,
                    options: @client.receipt_profiles.map { |r| [r.label, r.id] }, selected: @order.client_receipt_profile_id %>
            </div>

            <%# Línea completa: Dirección de entrega %>
            <div>
              <span class="mb-1 block text-sm font-semibold text-neutral-900">Dirección de entrega</span>
              <%= render "shared/custom_select", name: "order[client_branch_id]",
                    invalid: @order.errors[:client_branch_id].any?,
                    options: @client.branches.map { |b| [b.label, b.id] }, selected: @order.client_branch_id %>
            </div>

            <div class="pt-2 text-center">
              <%= f.submit (@order.persisted? ? "Guardar cambios" : "Continuar a levantamiento de pedido"),
                    class: "cursor-pointer rounded-full bg-brand-coral px-8 py-3 font-bold text-white transition-colors hover:bg-brand-coral-dark" %>
            </div>
          <% end %>
        <% else %>
          <p class="rounded-2xl bg-black/5 px-5 py-4 text-sm text-neutral-700">
            Busca al cliente por clave o nombre para comenzar.
          </p>
        <% end %>
      </div>
    </section>
  </div>
</div>
