<% content_for :title, "Resumen del pedido · Rueda de Negocios" %>

<div class="relative min-h-screen w-full overflow-hidden bg-black">
  <div class="pointer-events-none absolute inset-0 bg-cover bg-center opacity-[0.18]"
       style="background-image: url('<%= image_path "tools_pattern_white.svg" %>');"></div>

  <%# z-20 (no z-10): hermano del contenido (z-10) y contiene el modal de
      cerrar sesión — con el mismo z, el contenido lo taparía. %>
  <div class="relative z-20 px-6 pt-6 sm:px-10 lg:px-[5%] lg:pt-8">
    <%= render "shared/top_bar" %>
    <h1 class="mt-8 text-3xl font-extrabold text-white sm:text-4xl">Levantamiento de pedido</h1>
  </div>

  <div class="relative z-10 mx-auto max-w-xl px-6 py-12">
    <section class="rounded-3xl bg-brand-gold p-6 sm:p-8">
      <div class="rounded-2xl bg-black py-4 text-center">
        <h2 class="text-2xl font-extrabold text-white">Resumen del pedido</h2>
      </div>

      <p class="mt-4 text-center text-sm text-neutral-800">
        Pedido <span class="font-bold">#<%= @order.folio %></span> guardado correctamente.
      </p>

      <div class="mt-6 space-y-4">
        <%= link_to pdf_order_path(@order),
              class: "flex items-center gap-4 rounded-2xl bg-black px-6 py-5 text-lg font-semibold text-white transition-colors hover:bg-neutral-800" do %>
          <%= image_tag "icon_pdf.svg", alt: "", class: "h-8 w-8" %> Descargar PDF
        <% end %>

        <%# Correo aún no implementado: deshabilitado para no confirmar un
            envío que no ocurre (se enviará al sincronizar). Receta única de
            "Próximamente": fondo con alpha /60 + contenido opacity-60 + badge
            dorado a plena opacidad (igual que menu_card/report_card). %>
        <div class="flex w-full cursor-not-allowed items-center gap-4 rounded-2xl bg-neutral-400/60 px-6 py-5 text-lg font-semibold text-white"
             aria-disabled="true" title="Próximamente">
          <div class="flex flex-1 items-center gap-4 opacity-60">
            <%= image_tag "icon_mail.svg", alt: "", class: "h-8 w-8" %> Enviar por correo
          </div>
          <span class="rounded-full bg-brand-gold px-3 py-1 text-xs font-semibold text-neutral-900 shadow-md ring-1 ring-black/10">Próximamente</span>
        </div>

        <div class="flex items-center justify-center gap-3 pt-2">
          <%# El pedido capturado sigue siendo editable hasta transmitirse: dejar
              siempre un camino de regreso (evita el callejón sin salida). %>
          <%= link_to "Volver al pedido", order_path(@order),
                class: "inline-block rounded-full bg-neutral-700 px-8 py-3 font-bold text-white transition-colors hover:bg-neutral-600" %>
          <%= link_to "Terminar", root_path,
                class: "inline-block rounded-full bg-brand-coral px-8 py-3 font-bold text-white transition-colors hover:bg-brand-coral-dark" %>
        </div>
      </div>
    </section>
  </div>
</div>
