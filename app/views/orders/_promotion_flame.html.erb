<%#
  Botón de promoción de una fila. Abre el diálogo de SU promoción, que vive
  una sola vez al final de la tabla: con un diálogo por fila, un pedido de 45
  renglones de MAKITA cargaría 45 copias idénticas y las repintaría en cada
  cambio de cantidad.
  Locals: group (Promotions::Group).
%>
<% state = promotion_flame_state(group) %>
<button type="button" data-action="modal#open"
        data-modal-dialog-param="<%= promotion_dialog_id(group.promotion) %>"
        aria-label="<%= promotion_flame_label(group, state) %>"
        class="<%= promotion_flame_class(state) %>">
  <%# El fondo coral va en su propia capa, no en el botón: así el latido no
      deja residuo de opacidad al apagarse. Ver promotion_flame_backdrop_class. %>
  <% if state == :available %>
    <span class="<%= promotion_flame_backdrop_class %>" aria-hidden="true"></span>
  <% end %>
  <%# Heroicon outline `fire`. `relative` para quedar por encima del fondo. %>
  <svg class="relative h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" d="M15.362 5.214A8.252 8.252 0 0 1 12 21 8.25 8.25 0 0 1 6.038 7.047 8.287 8.287 0 0 0 9 9.601a8.983 8.983 0 0 1 3.361-6.867 8.21 8.21 0 0 0 3 2.48Z" />
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 18a3.75 3.75 0 0 0 .495-7.468 5.99 5.99 0 0 0-1.925 3.547 5.975 5.975 0 0 1-2.133-1.001A3.75 3.75 0 0 0 12 18Z" />
  </svg>
</button>
