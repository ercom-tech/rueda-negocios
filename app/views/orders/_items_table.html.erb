<%# Tabla de partidas. Locals: order. Id "order-detail" para el Turbo replace. %>
<div id="order-detail" class="overflow-x-auto rounded-3xl border border-black/10 bg-brand-cream text-neutral-900">
  <%# Contador contra el tope de partidas: visible siempre (no solo al
      acercarse), para que el capturista no llegue al límite a ciegas. %>
  <div class="flex items-center justify-end px-5 py-3 text-sm font-semibold">
    <span class="<%= "text-brand-coral-dark" if order.items_limit_reached? %>">
      Partidas <%= order.items_count_for_limit %> / <%= Order::MAX_ITEMS %>
    </span>
  </div>
  <table class="w-full text-sm">
    <thead class="bg-black text-white">
      <%# En tablet angosta se ocultan las columnas secundarias (no. de parte,
          unidad) y "Consecutivo" se abrevia a "#", para que cantidad/descuento/
          total queden a la vista sin scroll horizontal. %>
      <tr>
        <th class="px-3 py-3"></th>
        <th class="px-3 py-3 font-semibold"><span class="lg:hidden">#</span><span class="hidden lg:inline">Consecutivo</span></th>
        <th class="px-3 py-3 font-semibold">Código</th>
        <th class="px-3 py-3 text-left font-semibold">Descripción</th>
        <th class="hidden px-3 py-3 font-semibold lg:table-cell">No. de parte</th>
        <th class="px-3 py-3 font-semibold">Cantidad</th>
        <th class="hidden px-3 py-3 font-semibold lg:table-cell">Unidad</th>
        <th class="px-3 py-3 font-semibold">Precio unitario</th>
        <th class="px-3 py-3 font-semibold">Descuento</th>
        <th class="px-3 py-3 font-semibold">Total</th>
      </tr>
    </thead>
    <tbody>
      <% order.order_items.each do |item| %>
        <%= render "orders/item_row", order: order, item: item %>
      <% end %>
      <% if order.order_items.empty? %>
        <tr>
          <td colspan="10" class="px-4 py-10 text-center text-neutral-500">
            Agrega productos con el buscador de arriba.
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
