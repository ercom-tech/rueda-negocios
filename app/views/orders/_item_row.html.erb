<%# Fila de partida. Locals: order, item.
    Ids únicos por fila (tr, forms e inputs): el update repinta con morph, y
    idiomorph solo conserva el foco si empareja los nodos por id — con ids
    duplicados entre filas el foco moría y las flechas scrolleaban al inicio. %>
<tr id="<%= dom_id(item) %>" class="border-t border-black/10 text-center">
  <td class="px-2 py-2">
    <% if can_edit_order?(order) %>
      <div data-controller="modal" data-action="keydown@window->modal#closeOnEsc">
        <%# neutral-600 en reposo: el 400 daba 2.2:1 sobre crema y el realce
            rojo es hover-only — en tablet siempre se veía en su versión más
            tenue. El aria-label nombra la partida: las 45 filas se anunciaban
            igual y el lector de pantalla no sabía cuál borraba. %>
        <button type="button" data-action="modal#open" aria-label="Quitar producto — <%= item.description %>"
                class="inline-flex h-11 w-11 items-center justify-center text-neutral-600 transition-colors hover:text-red-600">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
          </svg>
        </button>
        <%# El mensaje lleva el consecutivo: si el producto está dos veces, la
            descripción sola no dice cuál de las dos se va a quitar.

            Id estable + turbo-permanent: este diálogo vive DENTRO de
            #order-detail, que se repinta con morph en cada alta, baja y
            edición de cantidad. Sin esto, idiomorph reescribía el `style` con
            el `display:none` del HTML nuevo y el modal recién abierto se
            cerraba solo — pasaba justo al corregir una cantidad y tocar el
            bote de basura de otra fila, la pareja de acciones más común. %>
        <%= render "home/confirm_dialog", title: "Quitar producto",
              id: dom_id(item, :remove_dialog), permanent: true,
              message: "¿Quitar la partida #{item.position}, \"#{item.description}\", del pedido?",
              confirm_label: "Sí, quitar", path: order_order_item_path(order, item), method: :delete %>
      </div>
    <% end %>
  </td>
  <td class="px-3 py-2"><%= item.position %></td>
  <td class="px-3 py-2"><%= item.code %></td>
  <td class="px-3 py-2 text-left"><%= item.description %></td>
  <td class="hidden px-3 py-2 lg:table-cell"><%= item.part_number %></td>

  <td class="px-3 py-2">
    <% if can_edit_order?(order) %>
      <%# `turbo:submit-end` revierte el campo al valor guardado si el envío
          falló (la pausa de sync responde 422): sin eso, el input se quedaba
          con lo tecleado, el total sin recalcular, y el siguiente blur ya no
          reenviaba porque el valor "no cambió". %>
      <%= form_with model: item, url: order_order_item_path(order, item), method: :patch,
            id: dom_id(item, :quantity_form),
            data: { controller: "form-submit", action: "turbo:submit-end->form-submit#flashStatus" } do |f| %>
        <%# Con empaque mínimo: el min del input ES el empaque (si no, la flecha
            ↓ desde el empaque se sujetaba a 1 y desalineaba: 10→1→11) y
            data-step-size hace que las flechas avancen alineadas a la rejilla
            de múltiplos. Sin empaque: min 1 y paso de 1.

            Se exige POSITIVO, igual que `OrderItemsController#create` y que
            `OrderItem#quantity_in_package_multiples`: con `|| 1` a secas, un
            empaque 0 del ERP daba min="0" y paso 0, así que la flecha ↓ bajaba
            hasta 0 y el modelo lo rechazaba al salir del campo. %>
        <% package_size = item.product&.min_sale_quantity %>
        <% package_size = nil unless package_size&.positive? %>
        <%= f.number_field :quantity, step: "any", id: dom_id(item, :quantity),
              min: number_with_precision(package_size || 1, strip_insignificant_zeros: true),
              value: number_with_precision(item.quantity, strip_insignificant_zeros: true),
              "aria-label": "Cantidad — #{item.description}",
              data: { action: "focus->form-submit#remember keydown->form-submit#stepWithArrows blur->form-submit#submitIfChanged",
                      step_size: (number_with_precision(package_size, strip_insignificant_zeros: true) if package_size) }.compact,
              class: "h-11 w-16 rounded-lg border border-neutral-300 bg-white px-2 text-center outline-none focus:border-brand-gold" %>
      <% end %>
    <% else %>
      <%= number_with_precision(item.quantity, strip_insignificant_zeros: true) %>
    <% end %>
  </td>

  <td class="hidden px-3 py-2 lg:table-cell"><%= item.unit %></td>
  <td class="px-3 py-2"><%= number_to_currency(item.unit_price) %></td>

  <td class="px-3 py-2">
    <% if can_edit_order?(order) %>
      <%= form_with model: item, url: order_order_item_path(order, item), method: :patch,
            id: dom_id(item, :discount_form),
            data: { controller: "form-submit", action: "turbo:submit-end->form-submit#flashStatus" } do |f| %>
        <div class="flex items-center justify-center gap-1">
          <%= f.number_field :discount_percent, min: 0, max: 100, step: "any", id: dom_id(item, :discount),
                value: number_with_precision(item.discount_percent, strip_insignificant_zeros: true),
                "aria-label": "Descuento (%) — #{item.description}",
                data: { action: "focus->form-submit#remember keydown->form-submit#stepWithArrows blur->form-submit#submitIfChanged" },
                class: "h-11 w-16 rounded-lg border border-neutral-300 bg-white px-2 text-center outline-none focus:border-brand-gold" %>
          <span>%</span>
        </div>
      <% end %>
    <% else %>
      <%= number_with_precision(item.discount_percent, strip_insignificant_zeros: true) %>%
    <% end %>
  </td>

  <%# Total de la partida CON descuento e IVA (item.total, como la columna
      Total del PDF) — line_total es solo cantidad × precio. %>
  <td class="px-3 py-2 font-semibold"><%= number_to_currency(item.total) %></td>
</tr>
