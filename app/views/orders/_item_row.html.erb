<%# Fila de partida. Locals: order, item. %>
<tr class="border-t border-black/10 text-center">
  <td class="px-2 py-2">
    <% if can_edit_order?(order) %>
      <div data-controller="modal" data-action="keydown@window->modal#closeOnEsc">
        <button type="button" data-action="modal#open" aria-label="Quitar producto"
                class="inline-flex h-11 w-11 items-center justify-center text-lg text-neutral-400 transition-colors hover:text-red-600">🗑</button>
        <%= render "home/confirm_dialog", title: "Quitar producto",
              message: "¿Quitar \"#{item.description}\" del pedido?",
              confirm_label: "Sí, quitar", path: order_order_item_path(order, item), method: :delete %>
      </div>
    <% end %>
  </td>
  <td class="px-3 py-2"><%= item.position %></td>
  <td class="px-3 py-2"><%= item.code %></td>
  <td class="px-3 py-2 text-left"><%= item.description %></td>
  <td class="px-3 py-2"><%= item.part_number %></td>

  <td class="px-3 py-2">
    <% if can_edit_order?(order) %>
      <%= form_with model: item, url: order_order_item_path(order, item), method: :patch,
            data: { controller: "form-submit" } do |f| %>
        <%= f.number_field :quantity, min: 1, step: "any",
              value: number_with_precision(item.quantity, strip_insignificant_zeros: true),
              data: { action: "change->form-submit#submit" },
              class: "h-11 w-16 rounded-lg border border-neutral-300 px-2 text-center outline-none focus:border-brand-gold" %>
      <% end %>
    <% else %>
      <%= number_with_precision(item.quantity, strip_insignificant_zeros: true) %>
    <% end %>
  </td>

  <td class="px-3 py-2"><%= item.unit %></td>
  <td class="px-3 py-2"><%= number_to_currency(item.unit_price) %></td>

  <td class="px-3 py-2">
    <% if can_edit_order?(order) %>
      <%= form_with model: item, url: order_order_item_path(order, item), method: :patch,
            data: { controller: "form-submit" } do |f| %>
        <div class="flex items-center justify-center gap-1">
          <%= f.number_field :discount_percent, min: 0, max: 100, step: "any",
                value: number_with_precision(item.discount_percent, strip_insignificant_zeros: true),
                data: { action: "change->form-submit#submit" },
                class: "h-11 w-16 rounded-lg border border-neutral-300 px-2 text-center outline-none focus:border-brand-gold" %>
          <span>%</span>
        </div>
      <% end %>
    <% else %>
      <%= number_with_precision(item.discount_percent, strip_insignificant_zeros: true) %>%
    <% end %>
  </td>

  <td class="px-3 py-2 font-semibold"><%= number_to_currency(item.line_total) %></td>
</tr>
